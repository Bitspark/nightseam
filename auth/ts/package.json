{
  "name": "@nightseam/auth",
  "version": "0.5.0",
  "description": "The optional authority profile for Nightseam: the rooted, attenuating grant, the authenticated connection and its bootstrap, and the exposure that binds a policy to a generated surface \u2014 held to the shared tables, with Archon as the identity layer.",
  "license": "Apache-2.0",
  "author": "Bitspark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitspark/nightseam.git",
    "directory": "auth/ts"
  },
  "homepage": "https://github.com/Bitspark/nightseam#readme",
  "bugs": "https://github.com/Bitspark/nightseam/issues",
  "keywords": [
    "duplex",
    "authorization",
    "grant",
    "ed25519",
    "archon"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./grant": "./src/grant.ts",
    "./connection": "./src/connection.ts",
    "./exposure": "./src/exposure.ts",
    "./over": "./src/over.ts"
  },
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./grant": {
        "types": "./dist/grant.d.ts",
        "import": "./dist/grant.js",
        "default": "./dist/grant.js"
      },
      "./connection": {
        "types": "./dist/connection.d.ts",
        "import": "./dist/connection.js",
        "default": "./dist/connection.js"
      },
      "./exposure": {
        "types": "./dist/exposure.d.ts",
        "import": "./dist/exposure.js",
        "default": "./dist/exposure.js"
      },
      "./over": {
        "types": "./dist/over.d.ts",
        "import": "./dist/over.js",
        "default": "./dist/over.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@bitspark/archon": "^0.7.0",
    "@bitspark/archon-sdk": "^0.7.0",
    "@nightseam/runtime": "workspace:*",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@nightseam/duplex": "workspace:*",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --experimental-strip-types --test --test-timeout=20000 src/grant.test.ts src/connection.test.ts src/exposure.test.ts src/over.test.ts src/dependencies.test.ts"
  }
}
