{
  "name": "@nightseam/session",
  "version": "0.2.0",
  "description": "A session over the seam's connections: the relay, the registry, the holder of control, an in-memory log.",
  "license": "Apache-2.0",
  "author": "Bitspark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitspark/nightseam.git",
    "directory": "session/ts"
  },
  "homepage": "https://github.com/Bitspark/nightseam#readme",
  "bugs": "https://github.com/Bitspark/nightseam/issues",
  "keywords": [
    "duplex",
    "session",
    "relay",
    "control"
  ],
  "type": "module",
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@nightseam/duplex": "workspace:*",
    "@nightseam/runtime": "workspace:*",
    "@nightseam/tunnel": "workspace:*"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit --strict --target ES2022 --module nodenext --allowImportingTsExtensions --skipLibCheck src/index.ts src/observer.check.ts",
    "test": "node --experimental-strip-types --test --test-timeout=10000 src/session.test.ts src/connection.test.ts src/seam.test.ts"
  }
}
