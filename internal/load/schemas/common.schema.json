{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nightseam:v1:common",
  "$defs": {
    "familyName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "typeName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_]*$"
    },
    "memberName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "wireName": {
      "type": "string",
      "minLength": 1
    },
    "parameterName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "imports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/familyName"
      }
    },
    "expr": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.|[A-Z][A-Za-z0-9]*\\.)?[A-Za-z][A-Za-z0-9_]*$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "array"
          ],
          "properties": {
            "array": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "map"
          ],
          "properties": {
            "map": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nullable"
          ],
          "properties": {
            "nullable": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/typeName"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apply",
            "with"
          ],
          "properties": {
            "apply": {
              "type": "string",
              "pattern": "^(?:[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.)?[A-Z][A-Za-z0-9_]*$"
            },
            "with": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/familyName"
                  },
                  {
                    "$ref": "#/$defs/expr"
                  }
                ]
              }
            }
          }
        },
        {
          "$ref": "#/$defs/type"
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/memberName"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/expr"
        },
        "required": {
          "type": "boolean"
        },
        "nullable": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "length": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "type": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "record"
            },
            "description": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            },
            "extends": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/typeName"
              }
            },
            "open": {
              "type": "boolean"
            },
            "parameters": {
              "$ref": "#/$defs/parameters"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "description": {
              "type": "string"
            },
            "key": {
              "$ref": "#/$defs/memberName"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            },
            "extends": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/typeName"
              }
            },
            "open": {
              "type": "boolean"
            },
            "parameters": {
              "$ref": "#/$defs/parameters"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "description": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "type"
          ],
          "properties": {
            "kind": {
              "const": "alias"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "$ref": "#/$defs/expr"
            },
            "parameters": {
              "$ref": "#/$defs/parameters"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tag",
            "variants"
          ],
          "properties": {
            "kind": {
              "const": "union"
            },
            "description": {
              "type": "string"
            },
            "parameters": {
              "$ref": "#/$defs/parameters"
            },
            "tag": {
              "$ref": "#/$defs/memberName"
            },
            "value": {
              "$ref": "#/$defs/memberName"
            },
            "extends": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/typeName"
              }
            },
            "variants": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/wireName"
              },
              "additionalProperties": {
                "$ref": "#/$defs/expr"
              }
            }
          }
        }
      ]
    },
    "types": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/typeName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/type"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/parameterName"
          },
          "of": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
