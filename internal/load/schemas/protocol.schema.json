{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nightseam:v1:protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile"
  ],
  "$defs": {
    "side": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:nightseam:v1:common#/$defs/sideInheritance"
          }
        },
        "methods": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:nightseam:v1:common#/$defs/wireName"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "request": {
                "$ref": "urn:nightseam:v1:common#/$defs/expr"
              },
              "result": {
                "$ref": "urn:nightseam:v1:common#/$defs/expr"
              },
              "errors": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "events": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:nightseam:v1:common#/$defs/wireName"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "type": {
                "$ref": "urn:nightseam:v1:common#/$defs/expr"
              }
            }
          }
        },
        "crud": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:nightseam:v1:common#/$defs/typeName"
          },
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "list",
                "get",
                "create",
                "update",
                "delete"
              ]
            }
          }
        }
      }
    }
  },
  "properties": {
    "profile": {
      "const": "nightseam.duplex/1"
    },
    "imports": {
      "$ref": "urn:nightseam:v1:common#/$defs/imports"
    },
    "types": {
      "$ref": "urn:nightseam:v1:common#/$defs/types"
    },
    "parameters": {
      "$ref": "urn:nightseam:v1:common#/$defs/parameters"
    },
    "server": {
      "$ref": "#/$defs/side"
    },
    "client": {
      "$ref": "#/$defs/side"
    },
    "errors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
