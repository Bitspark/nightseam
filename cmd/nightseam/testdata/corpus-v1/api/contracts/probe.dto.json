{
  "schema_version": 1,
  "profile": "nightseam.duplex/1",
  "name": "probe",
  "layer": "dto",
  "types": {
    "Base": {
      "kind": "record",
      "description": "What every payload carries.",
      "fields": [
        {"name": "text", "type": "string", "description": "The text of the payload."}
      ]
    },
    "Payload": {
      "kind": "record",
      "description": "A payload: a base with a count and a note that may be absent or null.",
      "extends": ["Base"],
      "fields": [
        {"name": "count", "type": "integer"},
        {"name": "note", "type": "string", "required": false, "nullable": true}
      ]
    },
    "OpenRecord": {
      "kind": "record",
      "description": "A record that keeps the fields it does not declare.",
      "open": true,
      "fields": [
        {"name": "id", "type": "string", "go_name": "ID"},
        {"name": "note", "type": "string", "required": false}
      ]
    },
    "Status": {
      "kind": "enum",
      "description": "Where a probe stands.",
      "values": ["ready", "done", "context.example"]
    },
    "Payloads": {
      "kind": "alias",
      "description": "Payloads, in order.",
      "type": {"array": "Payload"}
    },
    "Counts": {
      "kind": "alias",
      "type": {"map": "integer"}
    },
    "Seen": {
      "kind": "record",
      "fields": [
        {"name": "at", "type": "timestamp"},
        {"name": "status", "type": "Status"},
        {"name": "extra", "type": "json", "required": false},
        {"name": "ratio", "type": "number"},
        {"name": "ok", "type": "boolean"}
      ]
    }
  }
}
