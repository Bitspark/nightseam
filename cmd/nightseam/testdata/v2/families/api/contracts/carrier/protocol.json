{
  "profile": "nightseam.duplex/1",
  "parameters": [
    {
      "name": "S",
      "of": "session"
    }
  ],
  "imports": [
    "probe"
  ],
  "types": {
    "Attachment": {
      "kind": "record",
      "fields": [
        {
          "name": "connection",
          "type": "S.Handle"
        },
        {
          "name": "last",
          "type": "integer"
        }
      ]
    },
    "Frame": {
      "kind": "record",
      "fields": [
        {
          "name": "sequence",
          "type": "integer"
        },
        {
          "name": "message",
          "type": "S.Envelope"
        }
      ]
    },
    "Frames": {
      "kind": "alias",
      "type": {
        "array": "Frame"
      }
    }
  },
  "server": {
    "methods": {
      "attach": {
        "request": "AttachParams",
        "result": "Attachment"
      },
      "relay": {
        "request": "Frame",
        "result": "probe.Envelope"
      }
    },
    "events": {
      "frame.relayed": {
        "type": "Frame"
      }
    }
  }
}
