{
  "schema_version": 1,
  "profile": "nightseam.duplex/1",
  "name": "probe",
  "layer": "rpc",
  "methods": [
    {
      "name": "echo",
      "description": "Returns the payload, its text reversed.",
      "go_name": "Echo",
      "ts_name": "echo",
      "direction": "client_to_server",
      "request": "Payload",
      "result": "Payload"
    },
    {
      "name": "reverse",
      "description": "Asks the client to reverse a payload.",
      "go_name": "Reverse",
      "ts_name": "reverse",
      "direction": "server_to_client",
      "request": "Payload",
      "result": "Payload"
    },
    {
      "name": "no_args",
      "description": "Takes nothing and returns a string.",
      "go_name": "NoArgs",
      "ts_name": "noArgs",
      "direction": "client_to_server",
      "result": "string"
    },
    {
      "name": "seen",
      "go_name": "Seen",
      "ts_name": "seen",
      "direction": "client_to_server",
      "request": "Seen",
      "result": "Payloads"
    }
  ],
  "events": [
    {
      "name": "changed",
      "description": "A payload changed.",
      "go_name": "Changed",
      "ts_name": "changed",
      "direction": "server_to_client",
      "type": "Payload"
    },
    {
      "name": "noticed",
      "go_name": "Noticed",
      "ts_name": "noticed",
      "direction": "client_to_server",
      "type": "Seen"
