{
  "profile": "nightseam.duplex/1",
  "parameters": [
    {
      "name": "S",
      "of": "protocol"
    },
    {
      "name": "T",
      "of": "protocol"
    }
  ],
  "imports": [
    "probe"
  ],
  "types": {
    "Both": {
      "kind": "record",
      "fields": [
        {
          "name": "frame",
          "type": "Frame"
        },
        {
          "name": "echoes",
          "type": {
            "array": "Echo"
          }
        }
      ]
    },
    "Echo": {
      "kind": "record",
      "fields": [
        {
          "name": "heard",
          "type": "T.Envelope"
        }
      ]
    },
    "Frame": {
      "kind": "record",
      "fields": [
        {
          "name": "message",
          "type": "S.Envelope"
        },
        {
          "name": "back",
          "type": "S.Handle"
        }
      ]
    },
    "Named": {
      "kind": "record",
      "fields": [
        {
          "name": "held",
          "type": "probe.Envelope"
        }
      ]
    }
  },
  "server": {
    "methods": {
      "named": {
        "request": "Named",
        "result": "Named"
      },
      "relay": {
        "request": "T.Envelope",
        "result": "Both"
      }
    },
    "events": {
      "echoed": {
        "type": "Echo"
      }
    }
  }
}
