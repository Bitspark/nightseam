{
  "name": "nightseam",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitspark/nightseam.git"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm --recursive --if-present check",
    "test": "pnpm --recursive --if-present test",
    "format": "prettier --write \"*/ts/src/**/*.ts\" \"docs/theory/**/*.ts\" \"docs/theory/*.mjs\"",
    "format:check": "prettier --check \"*/ts/src/**/*.ts\" \"docs/theory/**/*.ts\" \"docs/theory/*.mjs\""
  },
  "devDependencies": {
    "@nightseam/duplex": "workspace:*",
    "@nightseam/live": "workspace:*",
    "@nightseam/runtime": "workspace:*",
    "@nightseam/tunnel": "workspace:*",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.1",
    "prettier": "3.9.8",
    "@bitspark/bitwire": "0.2.0"
  }
}
