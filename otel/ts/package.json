{
  "name": "@nightseam/otel",
  "version": "0.5.0",
  "description": "The OpenTelemetry adapter for Nightseam: a Propagator over the W3C trace context propagator and an Observer that opens a span per request and records the rest.",
  "license": "Apache-2.0",
  "author": "Bitspark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitspark/nightseam.git",
    "directory": "otel/ts"
  },
  "homepage": "https://github.com/Bitspark/nightseam#readme",
  "bugs": "https://github.com/Bitspark/nightseam/issues",
  "keywords": [
    "duplex",
    "opentelemetry",
    "tracing",
    "trace-context",
    "observability"
  ],
  "type": "module",
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@nightseam/runtime": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.0"
  },
  "devDependencies": {
    "@nightseam/duplex": "workspace:*",
    "@nightseam/live": "workspace:*",
    "@nightseam/tunnel": "workspace:*",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --experimental-strip-types --test --test-timeout=10000 src/propagator.test.ts src/observer.test.ts src/spans.test.ts src/dependencies.test.ts"
  }
}
