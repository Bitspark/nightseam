# Source stays LF in every checkout so gofmt -l, diffs and the generator's
# byte comparison mean the same thing on Windows and Linux.
* text=auto eol=lf
*.go text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.txt text eol=lf
# Every fixture the generator's tests compare byte for byte.
cmd/nightseam/testdata/** text eol=lf
