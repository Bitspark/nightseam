package main

import (
	"context"
	"encoding/json"
	cellbinding "example.test/generated/api/go/cell-binding"
	cell "example.test/generated/api/go/cell-protocol"
	"fmt"
	"github.com/Bitspark/nightseam/duplex/go"
	"github.com/Bitspark/nightseam/live/go"
