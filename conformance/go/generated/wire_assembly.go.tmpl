package main

// These fixtures own transport assembly. Generated packages see only structured
// wires, models, and explicitly supplied adapter contexts.
import (
	"context"
	bitwire "github.com/Bitspark/bitwire/wire/go"
	"github.com/Bitspark/nightseam/live/go"
	"github.com/Bitspark/nightseam/runtime/go"
	"net/http"
	"sync"
)

// fixtureDispatchers holds one dispatcher per peer: the peer root has one
// owning attachment, so a fixture that both forwards a model and registers a
// handler of its own shares that owner rather than contending for it.
var fixtureDispatchers sync.Map

func fixtureDispatcher(peer *runtime.Peer) (*runtime.Dispatcher, error) {
	if held, ok := fixtureDispatchers.Load(peer); ok {
		return held.(*runtime.Dispatcher), nil
	}
	dispatch, err := runtime.NewDispatcher(peer.Wire())
	if err != nil {
		return nil, err
	}
	if held, loaded := fixtureDispatchers.LoadOrStore(peer, dispatch); loaded {
		_ = dispatch.Close(1000, "")
		return held.(*runtime.Dispatcher), nil
	}
	go func() {
		<-peer.Done()
		fixtureDispatchers.Delete(peer)
		_ = dispatch.Close(1000, "")
	}()
	return dispatch, nil
}

type fixtureWireFactory func(*runtime.Peer) (bitwire.Endpoint, error)

func fixturePrepare(options runtime.Options, build fixtureWireFactory) runtime.Options {
	prepare := options.Prepare
	options.Prepare = func(peer *runtime.Peer) error {
		if prepare != nil {
			if err := prepare(peer); err != nil {
				return err
			}
		}
		wire, err := build(peer)
		if err != nil {
			return err
		}
		dispatch, err := fixtureDispatcher(peer)
		if err != nil {
			_ = wire.Close(1000, "fixture assembly failed")
			return err
		}
		// The model takes the root route; an exact registration beside it — a
		// fixture's own operation — wins for its own path.
		detach, err := runtime.ForwardWire(dispatch.Select(nil), wire)
		if err != nil {
			_ = wire.Close(1000, "fixture assembly failed")
			return err
		}
		go func() { <-peer.Done(); detach(); _ = wire.Close(1000, "fixture disconnected") }()
		return nil
	}
	return options
}
func fixtureHandler(options runtime.ServerOptions, build fixtureWireFactory) (http.Handler, error) {
	options.Options = fixturePrepare(options.Options, build)
	return runtime.NewHandler(options)
}
func fixtureDial(ctx context.Context, endpoint string, options runtime.DialOptions, build fixtureWireFactory) (*runtime.Peer, error) {
	options.Options = fixturePrepare(options.Options, build)
	peer, _, err := runtime.Dial(ctx, endpoint, options)
	return peer, err
}
func fixtureLiveContext(peer *runtime.Peer, options runtime.Options) (runtime.AdapterContext, error) {
	scope, ok := live.ScopeOf(peer)
	if !ok {
		var err error
		scope, err = live.Over(peer, live.Options{})
		if err != nil {
			return runtime.AdapterContext{}, err
		}
	}
	return runtime.AdapterContext{Options: options, ValueEnvironment: live.ValueEnvironment(scope)}, nil
}
