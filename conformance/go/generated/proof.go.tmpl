type proofRemote = proof.Client[probe.Envelope, probe.Handle, string]
type proofClient = proof.Server[probe.Envelope, probe.Handle, string]
type proofServer struct{}

func (proofServer) Echo(_ context.Context, p probe.Payload) (probe.Payload, error) {
	return p, nil
}
func (proofServer) NoArgs(context.Context) (string, error) { return "proof", nil }
func (proofServer) Seen(context.Context, probe.Seen) (probe.Payloads, error) {
	return probe.Payloads{}, nil
}
func classifyPart(p proof.Part) string {
	switch p.Kind() {
	case proof.PartKindText:
		return "text:" + p.Text.Body
	case proof.PartKindImage:
		return "image:" + p.Image.URL
	case proof.PartKindCount:
		return fmt.Sprintf("count:%d", p.Count.Value)
	default:
		panic("generated decoder admitted no selected variant")
	}
}
func (proofServer) Classify(_ context.Context, p proof.Part) (string, error) {
	return classifyPart(p), nil
}
func (proofServer) ClassifyRich(_ context.Context, p proof.RichPart) (string, error) {
	if base, ok := proof.NarrowRichPartToPart(p); ok {
		return classifyPart(base), nil
	}
	if p.Kind() == proof.RichPartKindTable {
		return fmt.Sprintf("table:%d", len(p.Table.Rows)), nil
	}
	return "", fmt.Errorf("generated decoder admitted no selected variant")
}
func (proofServer) Parts(context.Context, proof.PartsRequest) (proof.Result[proof.Parts, string], error) {
	return proof.Result[proof.Parts, string]{Ok: &proof.ResultOkValue[proof.Parts, string]{Value: proof.Parts{Items: []proof.Part{
		{Text: &proof.TextPart{Type: proof.LiteralTextValue, Body: "hello 😀 �"}},
		{Count: &proof.PartCountValue{Value: 7}},
		{Image: &proof.PartImage{URL: "https://example.org/image", Alt: runtime.Some(runtime.Null[string]())}},
	}}}}, nil
}
func (proofServer) Relay(_ context.Context, p proof.Carried[probe.Envelope, probe.Handle, string]) (proof.Option[proof.Envelope], error) {
	// Retain the envelope's complete generated type, crossing the family boundary
	// through the codecs rather than a cast between differently named structs.
	data, err := json.Marshal(p.Message)
	if err != nil {
		return proof.Option[proof.Envelope]{}, err
	}
	var envelope proof.Envelope
	if err = json.Unmarshal(data, &envelope); err != nil {
		return proof.Option[proof.Envelope]{}, err
	}
	return proof.Option[proof.Envelope]{Some: &proof.OptionSomeValue[proof.Envelope]{Value: envelope}}, nil
}

type proofServed struct {
	http   *http.Server
	remote chan *proofRemote
	peers  []*runtime.Peer
}

func (s *proofServed) shutdown() {
	_ = s.http.Close()
	for _, peer := range s.peers {
		_ = peer.Close()
	}
}

type proofDialled struct {
	client proofClient
	peer   *runtime.Peer
	events chan proof.RichPart
	cancel context.CancelFunc
}

func (d *proofDialled) shutdown() { _ = d.peer.Close(); d.cancel() }

func (t *testee) proofDispatch(op string, raw map[string]json.RawMessage) (any, error) {
	switch op {
	case "gen.proof_serve":
		s := &proofServed{remote: make(chan *proofRemote, 16)}
		handler, err := fixtureHandler(runtime.ServerOptions{
			Authenticate: func(r *http.Request) (context.Context, error) { return r.Context(), nil },
			CheckOrigin:  func(*http.Request) bool { return true },
		}, func(peer *runtime.Peer) (duplex.Endpoint, error) {
			s.peers = append(s.peers, peer)
			return binding.ToWire(func(remote proofRemote) (proofClient, error) {
				s.remote <- &remote
				return proofClient{Methods: proofServer{}}, nil
			}, runtime.AdapterContext{}, runtime.JSONAdapter[probe.Envelope](), runtime.JSONAdapter[probe.Handle](), runtime.JSONAdapter[string]())
		})
		if err != nil {
			return nil, err
		}
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			return nil, err
		}
		s.http = &http.Server{Handler: handler}
		go func() { _ = s.http.Serve(listener) }()
		return map[string]any{"handle": t.mint("proofsrv", s), "url": "ws://" + listener.Addr().String()}, nil
	case "gen.proof_dial":
		ctx, cancel := context.WithCancel(context.Background())
		d := &proofDialled{events: make(chan proof.RichPart, 16), cancel: cancel}
		peer, err := fixtureDial(ctx, str(raw, "url"), runtime.DialOptions{}, func(peer *runtime.Peer) (duplex.Endpoint, error) {
			return client.ToWire(func(remote proofClient) (proofRemote, error) {
				d.client = remote
				return proofRemote{Events: proofClientEvents{d}}, nil
			}, runtime.AdapterContext{}, runtime.JSONAdapter[probe.Envelope](), runtime.JSONAdapter[probe.Handle](), runtime.JSONAdapter[string]())
		})
		if err != nil {
			cancel()
			return nil, err
		}
		d.peer = peer
		return map[string]any{"handle": t.mint("proofcl", d)}, nil
	case "gen.proof_names":
		names := []string{reflect.TypeOf(proof.OptionNone{}).Name(), reflect.TypeOf(proof.PartImage{}).Name(), reflect.TypeOf(proof.PartsRequest{}).Name(), reflect.TypeOf(proof.RichPartTable{}).Name()}
		sort.Strings(names)
		return names, nil
	case "gen.proof_validate":
		expression := proof.MustTypeExpression(str(raw, "type"))
		data := raw["value"]
		if text, ok := raw["text"]; ok {
			var source string
			_ = json.Unmarshal(text, &source)
			data = []byte(source)
		}
		err := proof.WireSchema().Bind(map[string]any{"S.Envelope": runtime.TypeArgument[probe.Envelope](), "S.Handle": runtime.TypeArgument[probe.Handle](), "Item": "string"}, nil).ValidateExpressionRaw(expression, data)
		if err != nil {
			return map[string]any{"valid": false, "code": "invalid", "message": err.Error()}, nil
		}
		return map[string]any{"valid": true}, nil
	case "client.proof_call", "client.proof_event":
		object, _ := t.lookup(str(raw, "on"))
		d, ok := object.(*proofDialled)
		if !ok {
			return nil, fail("unknown_handle", "%s", str(raw, "on"))
		}
		ctx, cancel := context.WithTimeout(context.Background(), within(raw))
		defer cancel()
		if op == "client.proof_event" {
			select {
			case p := <-d.events:
				return map[string]any{"data": decoded(p), "kind": string(p.Kind())}, nil
			case <-ctx.Done():
				return nil, fail("timeout", "no proof event")
			}
		}
		var result any
		var err error
		var rawCall bool
		_ = json.Unmarshal(raw["raw"], &rawCall)
		if rawCall {
			err = runtime.CallWire(ctx, d.peer.Wire(), []string{str(raw, "method")}, raw["params"], &result)
		} else {
			switch str(raw, "method") {
			case "classify":
				var p proof.Part
				err = json.Unmarshal(raw["params"], &p)
				if err == nil {
					result, err = d.client.Methods.Classify(ctx, p)
				}
			case "classify_rich":
				var p proof.RichPart
				err = json.Unmarshal(raw["params"], &p)
				if err == nil {
					result, err = d.client.Methods.ClassifyRich(ctx, p)
				}
			case "parts":
				var p proof.PartsRequest
				err = json.Unmarshal(raw["params"], &p)
				if err == nil {
					result, err = d.client.Methods.Parts(ctx, p)
				}
			case "relay":
				var p proof.Carried[probe.Envelope, probe.Handle, string]
				err = json.Unmarshal(raw["params"], &p)
				if err == nil {
					result, err = d.client.Methods.Relay(ctx, p)
				}
			default:
				return nil, fail("invalid", "unknown proof method")
			}
		}
		if err != nil {
			return map[string]any{"error": callError(err)}, nil
		}
		return map[string]any{"result": decoded(result)}, nil
	case "server.proof_emit":
		object, _ := t.lookup(str(raw, "on"))
		s, ok := object.(*proofServed)
		if !ok {
			return nil, fail("unknown_handle", "%s", str(raw, "on"))
		}
		var p proof.RichPart
		if err := json.Unmarshal(raw["data"], &p); err != nil {
			return nil, err
		}
		ctx, cancel := context.WithTimeout(context.Background(), within(raw))
		defer cancel()
		select {
		case r := <-s.remote:
			defer func() { s.remote <- r }()
			return nil, r.Events.PartAdded(ctx, p)
		case <-ctx.Done():
			return nil, fail("timeout", "no proof client")
		}
	}
	return nil, fail("unsupported", "no proof op %s", op)
}

type proofClientEvents struct{ dialled *proofDialled }

func (e proofClientEvents) PartAdded(_ context.Context, p proof.RichPart) error {
	e.dialled.events <- p
	return nil
}
func (proofClientEvents) Changed(context.Context, probe.Payload) error { return nil }
