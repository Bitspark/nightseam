{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "ws": ["{checkout}/conformance/ts/node_modules/@types/ws/index.d.ts"],
      "@example/*/types": ["./api/ts/*/src/types.ts"],
      "@example/*": [
        "./api/ts/*/src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "api/ts/**/*.ts"
  ]
}
