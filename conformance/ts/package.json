{
  "name": "@nightseam/conformance",
  "version": "0.0.0",
  "private": true,
  "description": "The TypeScript testee of Nightseam's conformance suite: the runtime, tunnel and session under the runner's control over conformance/DRIVER.md. Never published.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@nightseam/duplex": "workspace:*",
    "@nightseam/runtime": "workspace:*",
    "@nightseam/session": "workspace:*",
    "@nightseam/tunnel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/ws": "^8.5.13",
    "ws": "^8.18.0"
  },
  "scripts": {
    "check": "tsc --noEmit --strict --target ES2022 --module nodenext --allowImportingTsExtensions --skipLibCheck src/testee.ts"
  }
}
