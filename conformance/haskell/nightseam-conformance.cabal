cabal-version: 2.4
name: nightseam-conformance
version: 0.5.0
build-type: Simple
license: Apache-2.0

executable nightseam-haskell-testee
  main-is: Main.hs
  other-modules: RecordedWire
  hs-source-dirs: src
  build-depends: base >=4.18 && <5, nightseam-duplex, nightseam-runtime, aeson, async, bytestring, base64-bytestring, containers, stm, text, vector
  default-language: Haskell2010
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2 -Wall
