    }},
    "MorePart": {"kind": "union", "tag": "kind", "extends": ["Part"], "variants": {"flag": "boolean"}},
    "CustomPart": {"kind": "union", "tag": "case", "value": "data", "variants": {"number": "number"}},
    "Box": {"kind": "record", "parameters": [{"name": "T"}], "fields": [{"name": "item", "type": "T", "required": true}]},
    "Items": {"kind": "alias", "parameters": [{"name": "T"}], "type": {"array": "T"}},
    "Result": {"kind": "union", "tag": "kind", "parameters": [{"name": "T"}], "variants": {"ok": "T", "error": "string"}},
    "StringBox": {"kind": "record", "fields": [{"name": "item", "type": "string", "required": true}]},
    "Identity": {"kind": "alias", "parameters": [{"name": "T"}], "type": "T"},
    "Cycle": {"kind": "alias", "parameters": [{"name": "T"}], "type": {"apply": "Identity", "with": {"T": {"apply": "Cycle", "with": {"T": "T"}}}}},
    "BoundResult": {"kind": "union", "tag": "kind", "variants": {"ok": "Base", "error": "string"}},
    "GenericFamily": {"kind": "alias", "parameters": [{"name": "S", "of": "protocol"}], "type": {"apply": "peer.Box", "with": {"S": "S"}}},
    "NullableValueRecord": {"kind": "record", "fields": [{"name": "text", "type": "string", "required": true}, {"name": "value", "type": {"nullable": "integer"}, "required": true}]},
    "Nested": {"kind": "alias", "parameters": [{"name": "T"}], "type": {"apply": "peer.Generic", "with": {"T": {"apply": "Box", "with": {"T": "T"}}}}}
  }},
