{
  "description": "The conformance table of the wire validator every runtime carries: one family's wire description, one imported family's, and cases of a type expression, a JSON value, and whether the value is valid. The imported family's envelope carries the trace context and the meta every injected envelope carries, so that a slot of it is held to accepting traceparent, tracestate and a flat map of strings, and to refusing any of them at another type. The reserved nightseam. prefix of a meta key is the peer's rule and no facet of the type, so a reserved key passes the slot here and the frame carrying it is refused by the peer; tables/frames.json holds that. Both runtimes read this file. An invalid case carries the message the runtimes print for it, pointer and text as one string: the pointer names the member that was wrong and the text states the fact, and both runtimes are held to it word for word, so that a consumer whose server is in one language and client in the other reads one spelling of one refusal. A case crossing into an imported family carries the one pointer the value was handed in at, not a root per family it crossed. A type drawn from a parameter is not among the cases: the TypeScript validator holds it to the binding of the parameter and the Go validator passes it through, since a generated Go codec validates it where the generic type is instantiated; each runtime tests its own way.",
  "wire": {
    "Base": {"kind": "record", "fields": [{"name": "text", "type": "string", "required": true}]},
    "Payload": {"kind": "record", "extends": ["Base"], "fields": [
      {"name": "count", "type": "integer", "required": true, "min": 0, "max": 100},
      {"name": "note", "type": "string", "required": false, "nullable": true, "length": {"min": 1, "max": 5}},
      {"name": "tag", "type": "string", "required": false, "pattern": "^[a-z]+$"},
      {"name": "when", "type": "timestamp", "required": false}
    ]},
    "Open": {"kind": "record", "open": true, "fields": [{"name": "id", "type": "string", "required": true}]},
    "Status": {"kind": "enum", "values": ["on", "off"]},
    "Payloads": {"kind": "alias", "type": {"array": "Payload"}},
    "Counts": {"kind": "alias", "type": {"map": "integer"}},
    "User": {"kind": "entity", "key": "id", "fields": [{"name": "id", "type": "string", "required": true}, {"name": "name", "type": "string", "required": true}]},
    "Held": {"kind": "record", "fields": [{"name": "who", "type": {"ref": "User"}, "required": true}, {"name": "other", "type": "peer.Thing", "required": true}]},
    "Frame": {"kind": "record", "fields": [{"name": "inner", "type": {"apply": "peer.Box", "with": {"S": "peer"}}, "required": true}]},
    "Unflagged": {"kind": "record", "fields": [{"name": "text", "type": "string"}]}
  },
  "imported": {
    "peer": {
      "Envelope": {"kind": "record", "fields": [{"name": "version", "type": "integer", "required": true}, {"name": "traceparent", "type": "string", "required": false}, {"name": "tracestate", "type": "string", "required": false}, {"name": "meta", "type": {"map": "string"}, "required": false}]},
      "Thing": {"kind": "record", "fields": [{"name": "n", "type": "integer", "required": true}]},
      "Box": {"kind": "record", "fields": [{"name": "item", "type": "S.Envelope", "required": true}]}
    }
  },
  "cases": [
    {"expression": "string", "value": "x", "valid": true},
    {"expression": "string", "value": 1, "valid": false, "message": "$: expected string"},
    {"expression": "boolean", "value": true, "valid": true},
    {"expression": "integer", "value": 7, "valid": true},
    {"expression": "integer", "value": "7", "valid": false, "message": "$: expected integer"},
    {"expression": "integer", "value": 7.5, "valid": false, "message": "$: expected JavaScript-safe integer"},
    {"expression": "integer", "value": 9007199254740992, "valid": false, "message": "$: expected JavaScript-safe integer"},
    {"expression": "integer", "value": 1e3, "valid": true},
    {"expression": "integer", "value": 1e400, "valid": false, "message": "$: expected finite number"},
    {"expression": "number", "value": 7.5, "valid": true},
    {"expression": "number", "value": "7.5", "valid": false, "message": "$: expected number"},
    {"expression": "number", "value": 1e400, "valid": false, "message": "$: expected finite number"},
    {"expression": "timestamp", "value": "2024-02-29T00:00:00Z", "valid": true},
    {"expression": "timestamp", "value": "2024-02-30T00:00:00Z", "valid": false, "message": "$: expected RFC3339 timestamp"},
    {"expression": "timestamp", "value": 1, "valid": false, "message": "$: expected timestamp"},
    {"expression": "json", "value": {"any": [1, "two", null]}, "valid": true},
    {"expression": "json", "value": {"any": [1, 1e400]}, "valid": false, "message": "$.any[1]: expected finite JSON number"},
    {"expression": "Status", "value": "on", "valid": true},
    {"expression": "Status", "value": "dim", "valid": false, "message": "$: expected Status"},
    {"expression": "Status", "value": 1, "valid": false, "message": "$: expected Status"},
    {"expression": "Payload", "value": {"text": "t", "count": 3}, "valid": true},
    {"expression": "Payload", "value": 1, "valid": false, "message": "$: expected Payload object"},
    {"expression": "Payload", "value": {"count": 3}, "valid": false, "message": "$.text: required field missing"},
    {"expression": "Payload", "value": {"text": "t", "count": 3, "note": null}, "valid": true},
    {"expression": "Payload", "value": {"text": "t", "count": 3, "extra": 1}, "valid": false, "message": "$.extra: unknown field"},
    {"expression": "Payload", "value": {"text": null, "count": 3}, "valid": false, "message": "$.text: null is not permitted"},
    {"expression": "Payload", "value": {"text": "t", "count": 101}, "valid": false, "message": "$.count: expected at most 100"},
    {"expression": "Payload", "value": {"text": "t", "count": -1}, "valid": false, "message": "$.count: expected at least 0"},
    {"expression": "Payload", "value": {"text": "t", "count": 3, "note": "toolong"}, "valid": false, "message": "$.note: expected a length of at most 5"},
    {"expression": "Payload", "value": {"text": "t", "count": 3, "note": ""}, "valid": false, "message": "$.note: expected a length of at least 1"},
    {"expression": "Payload", "value": {"text": "t", "count": 3, "tag": "abc"}, "valid": true},
    {"expression": "Payload", "value": {"text": "t", "count": 3, "tag": "ABC"}, "valid": false, "message": "$.tag: expected a match of ^[a-z]+$"},
    {"expression": "Open", "value": {"id": "1", "anything": {"deep": [true]}}, "valid": true},
    {"expression": "Open", "value": {"id": "1", "anything": {"deep": [1e400]}}, "valid": false, "message": "$.anything.deep[0]: expected finite JSON number"},
    {"expression": "Payloads", "value": [{"text": "t", "count": 1}], "valid": true},
    {"expression": "Payloads", "value": [{"text": "t"}], "valid": false, "message": "$[0].count: required field missing"},
    {"expression": "Counts", "value": {"a": 1}, "valid": true},
    {"expression": "Counts", "value": {"a": "1"}, "valid": false, "message": "$.a: expected integer"},
    {"expression": {"array": "Status"}, "value": ["on"], "valid": true},
    {"expression": {"array": "Status"}, "value": "on", "valid": false, "message": "$: expected array"},
    {"expression": {"map": "Status"}, "value": {"k": "off"}, "valid": true},
    {"expression": {"map": "Status"}, "value": ["off"], "valid": false, "message": "$: expected object"},
    {"expression": {"ref": "Nope"}, "value": "x", "valid": false, "message": "$: expected known entity"},
    {"expression": {"ref": "Base"}, "value": "x", "valid": false, "message": "$: expected entity with a key"},
    {"expression": {"empty": true}, "value": {}, "valid": true},
    {"expression": {"empty": true}, "value": {"x": 1}, "valid": false, "message": "$: expected empty object"},
    {"expression": {"empty": true}, "value": 1, "valid": false, "message": "$: expected empty object"},
    {"expression": {"nothing": true}, "value": 1, "valid": false, "message": "$: expected supported type expression"},
    {"expression": "Held", "value": {"who": "user-1", "other": {"n": 2}}, "valid": true},
    {"expression": "Held", "value": {"who": 5, "other": {"n": 2}}, "valid": false, "message": "$.who: expected string"},
    {"expression": "Held", "value": {"who": "u", "other": {"n": "two"}}, "valid": false, "message": "$.other.n: expected integer"},
    {"expression": "peer.Thing", "value": {"n": 1}, "valid": true},
    {"expression": "nobody.Thing", "value": {"n": 1}, "valid": false, "message": "$: expected known family"},
    {"expression": "Frame", "value": {"inner": {"item": {"version": 1}}}, "valid": true},
    {"expression": "peer.Envelope", "value": {"version": 1}, "valid": true},
    {"expression": "peer.Envelope", "value": {"nope": 1}, "valid": false, "message": "$.version: required field missing"},
    {"expression": "peer.Envelope", "value": {"version": 1, "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "tracestate": "vendor=1"}, "valid": true},
    {"expression": "peer.Envelope", "value": {"version": 1, "tracestate": "vendor=1"}, "valid": true},
    {"expression": "peer.Envelope", "value": {"version": 1, "traceparent": 1}, "valid": false, "message": "$.traceparent: expected string"},
    {"expression": "peer.Envelope", "value": {"version": 1, "meta": {"tenant": "acme", "idempotency": "k-1"}}, "valid": true},
    {"expression": "peer.Envelope", "value": {"version": 1, "meta": {}}, "valid": true},
    {"expression": "peer.Envelope", "value": {"version": 1, "meta": {"nightseam.cause": "nightly"}}, "valid": true},
    {"expression": "peer.Envelope", "value": {"version": 1, "meta": "acme"}, "valid": false, "message": "$.meta: expected object"},
    {"expression": "peer.Envelope", "value": {"version": 1, "meta": ["acme"]}, "valid": false, "message": "$.meta: expected object"},
    {"expression": "peer.Envelope", "value": {"version": 1, "meta": {"attempt": 2}}, "valid": false, "message": "$.meta.attempt: expected string"},
    {"expression": "peer.Envelope", "value": {"version": 1, "meta": {"tenant": null}}, "valid": false, "message": "$.meta.tenant: expected string"},
    {"expression": "Frame", "value": {"inner": {"nope": 1}}, "valid": false, "message": "$.inner.item: required field missing"},
    {"expression": "Nope", "value": 1, "valid": false, "message": "$: expected known type"},
    {"expression": "Unflagged", "value": {}, "valid": true},
    {"expression": "Unflagged", "value": {"text": "x"}, "valid": true},
    {"expression": "Unflagged", "value": {"text": 1}, "valid": false, "message": "$.text: expected string"}
  ]
}
