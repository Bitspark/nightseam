  "patterns": [
    {"pattern": "", "valid": true, "why": "an empty pattern matches without adding a restriction"},
    {"pattern": "^(?:ab|cd)+$", "valid": true, "why": "noncapturing groups are in both engines and the declared dialect"},
    {"pattern": "^\\\\1$", "valid": true, "why": "an escaped backslash followed by a digit is not a backreference"},
    {"pattern": "^[a-z]+$", "valid": true, "why": "plain syntax both engines read the same way"},
    {"pattern": "^[A-Za-z0-9_.-]{1,64}$", "valid": true, "why": "classes, a bounded repetition and anchors, all in the dialect"},
    {"pattern": "^(a|b)+c*d?$", "valid": true, "why": "groups, alternation and quantifiers"},
    {"pattern": "^\\d{3}-\\d{4}$", "valid": true, "why": "escapes both engines read the same way"},
    {"pattern": "^[[:alpha:]]+$", "valid": false, "why": "a POSIX class: RE2 reads a class of letters, ECMAScript an ordinary class of [ : a l p h, and both compile — the silent disagreement the dialect exists to remove"},
    {"pattern": "(?P<x>a)b", "valid": false, "why": "a named group of RE2; ECMAScript throws on it"},
    {"pattern": "^(?i)abc$", "valid": false, "why": "inline flags of RE2; ECMAScript throws on them"},
    {"pattern": "^(?<name>a)b$", "valid": false, "why": "a named group of ECMAScript; RE2 does not read it"},
    {"pattern": "^a(?=b)", "valid": false, "why": "a lookahead: ECMAScript only, and the dialect has no lookaround"},
    {"pattern": "^(?<=a)b$", "valid": false, "why": "a lookbehind: ECMAScript only, and the dialect has no lookaround"},
    {"pattern": "^(a)\\1$", "valid": false, "why": "a backreference: ECMAScript only, and the dialect has none"},
    {"pattern": "^\\p{L}+$", "valid": false, "why": "a Unicode class ECMAScript reads only under a flag the dialect does not carry"},
    {"pattern": "\\Aabc\\z", "valid": false, "why": "anchors of RE2; ECMAScript does not read them — write ^ and $"},
    {"pattern": "^[a-$", "valid": false, "why": "not a regular expression at all"},
    {"pattern": "(?s:.)", "valid": false, "why": "scoped inline flags are outside the dialect too"},
    {"pattern": "\\Qliteral\\E", "valid": false, "why": "RE2 quoted spans are outside the dialect"}
  ],
