{
  "name": "a scope that closes settles what it had in flight and revives nothing",
  "layer": "live",
  "description": "Closure is not a barrier: it settles every invocation in flight rather than leaving it hanging, and the scope that ended holds nothing afterwards.",
  "needs": [
    "live",
    "peer"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "live.over",
      "args": {
        "on": "$pa"
      },
      "bind": "la"
    },
    {
      "on": "b",
      "op": "live.over",
      "args": {
        "on": "$pb"
      },
      "bind": "lb"
    },
    {
      "on": "a",
      "op": "live.export",
      "args": {
        "on": "$la",
        "contract": "probe/Report",
        "behavior": {
          "kind": "wait"
        }
      },
      "bind": {
        "reference": "r"
      }
    },
    {
      "on": "b",
      "op": "live.import",
      "args": {
        "on": "$lb",
        "reference": "$r",
        "contract": "probe/Report"
      },
      "bind": {
        "handle": "at"
      }
    },
    {
      "on": "b",
      "op": "live.invoke",
      "args": {
        "on": "$at",
        "request": null
      },
      "bind": {
        "handle": "pending"
      }
    },
    {
      "on": "a",
      "op": "live.await_invocation",
      "args": {
        "on": "$la",
        "contract": "probe/Report"
      },
      "expect": {
        "contract": "probe/Report",
        "outcome": "started"
      }
    },
    {
      "on": "b",
      "op": "live.close",
      "args": {
        "on": "$lb"
      }
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$pending"
      },
      "expect": {
        "error": {
          "code": "scope_closed"
        }
      },
      "note": "settled, not left hanging"
    },
    {
      "on": "b",
      "op": "live.counts",
      "args": {
        "on": "$lb"
      },
      "expect": {
        "exports": 0,
        "imports": 0
      },
      "note": "a closed scope holds nothing"
    }
  ]
}
