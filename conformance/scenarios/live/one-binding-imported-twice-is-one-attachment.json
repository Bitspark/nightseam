{
  "name": "one binding imported twice is one attachment and both aliases answer",
  "layer": "live",
  "description": "Repeated import shares its dispatch: two attachments on one binding would be two readers competing for one reply.",
  "needs": [
    "live",
    "peer"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "live.over",
      "args": {
        "on": "$pa"
      },
      "bind": "la"
    },
    {
      "on": "b",
      "op": "live.over",
      "args": {
        "on": "$pb"
      },
      "bind": "lb"
    },
    {
      "on": "a",
      "op": "live.export",
      "args": {
        "on": "$la",
        "contract": "probe/Report",
        "behavior": {
          "kind": "echo"
        }
      },
      "bind": {
        "reference": "r"
      }
    },
    {
      "on": "b",
      "op": "live.import",
      "args": {
        "on": "$lb",
        "reference": "$r",
        "contract": "probe/Report"
      },
      "bind": {
        "handle": "once"
      }
    },
    {
      "on": "b",
      "op": "live.import",
      "args": {
        "on": "$lb",
        "reference": "$r",
        "contract": "probe/Report"
      },
      "bind": {
        "handle": "again"
      }
    },
    {
      "on": "b",
      "op": "live.counts",
      "args": {
        "on": "$lb"
      },
      "expect": {
        "exports": 0,
        "imports": 1
      },
      "note": "imported twice, attached once"
    },
    {
      "on": "b",
      "op": "live.invoke",
      "args": {
        "on": "$once",
        "request": 1
      },
      "bind": {
        "handle": "c1"
      }
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c1"
      },
      "expect": {
        "result": 1
      }
    },
    {
      "on": "b",
      "op": "live.invoke",
      "args": {
        "on": "$again",
        "request": 2
      },
      "bind": {
        "handle": "c2"
      }
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c2"
      },
      "expect": {
        "result": 2
      },
      "note": "neither alias took the other's reply"
    },
    {
      "on": "b",
      "op": "live.release",
      "args": {
        "on": "$lb",
        "reference": "$r"
      }
    },
    {
      "on": "b",
      "op": "live.import",
      "args": {
        "on": "$lb",
        "reference": "$r",
        "contract": "probe/Report"
      },
      "expect_error": {
        "code": "reference_released"
      },
      "note": "release invalidates every alias at once"
    },
    {
      "on": "b",
      "op": "live.counts",
      "args": {
        "on": "$lb"
      },
      "expect": {
        "exports": 0,
        "imports": 0
      }
    }
  ]
}
