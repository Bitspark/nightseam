{
  "name": "a frame over the limit is refused, and the connection with it",
  "layer": "seam",
  "replaces": "duplex/go/duplextest, its fourth scenario",
  "needs": [
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.conns",
      "bind": {
        "a": "ca",
        "b": "cb"
      },
      "args": {
        "limit_a": 1024,
        "limit_b": 1048576
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": ""
      },
      "expect": {},
      "expect_error": {
        "code": "$regex:^(closed|failed)$"
      },
      "note": "1025 bytes to a side whose limit is 1024; the receiver may reject from the frame header and close while this write is still in progress"
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect_error": {
        "code": "$regex:^(closed|failed)$"
      },
      "note": "the frame is refused and the connection ends: a close the transport sent, or a failure"
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca",
        "within_ms": 500
      },
      "expect_error": {
        "code": "$regex:^(closed|failed)$"
      },
      "note": "and stays ended"
    }
  ]
}
