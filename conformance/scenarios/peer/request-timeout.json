{
  "name": "a call whose deadline passes ends with request_timeout, and the connection serves on",
  "layer": "peer",
  "needs": ["peer", "listen"],
  "steps": [
    {"on": "a", "op": "peer.listen", "bind": {"handle": "l", "url": "url"}},
    {"on": "b", "op": "peer.dial", "args": {"url": "$url", "options": {"request_timeout_ms": 300}}, "bind": "pb"},
    {"on": "a", "op": "peer.accept", "args": {"on": "$l"}, "bind": "pa"},
    {"on": "a", "op": "peer.handle", "args": {"on": "$pa", "method": "wait", "behavior": {"kind": "wait"}}},
    {"on": "a", "op": "peer.handle", "args": {"on": "$pa", "method": "echo", "behavior": {"kind": "echo"}}},
    {"on": "b", "op": "peer.call", "args": {"on": "$pb", "method": "wait", "params": {}}, "bind": "c"},
    {"on": "b", "op": "call.await", "args": {"on": "$c", "within_ms": 3000}, "expect": {"error": {"code": "request_timeout"}}},
    {"on": "a", "op": "peer.await_request", "args": {"on": "$pa", "method": "wait", "phase": "ended"}, "expect": {"outcome": "cancelled"}, "note": "the caller's deadline cancels the handler too"},
    {"on": "b", "op": "peer.call", "args": {"on": "$pb", "method": "echo", "params": 1}, "bind": "c2"},
    {"on": "b", "op": "call.await", "args": {"on": "$c2"}, "expect": {"result": 1}}
  ]
}
