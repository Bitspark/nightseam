{
  "name": "a well-formed frame of every kind is taken without ending the connection",
  "layer": "peer",
  "needs": [
    "peer",
    "seam",
    "listen"
  ],
  "foreach": {
    "table": "tables/frames.json",
    "as": "row",
    "where": {
      "valid": true
    }
  },
  "steps": [
    {
      "on": "b",
      "op": "peer.listen",
      "bind": {
        "handle": "l",
        "url": "url"
      }
    },
    {
      "on": "a",
      "op": "conn.dial",
      "args": {
        "url": "$url"
      },
      "bind": "ca"
    },
    {
      "on": "b",
      "op": "peer.accept",
      "args": {
        "on": "$l"
      },
      "bind": "pb"
    },
    {
      "on": "b",
      "op": "peer.handle",
      "args": {
        "on": "$pb",
        "method": "read",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "$row.frame"
      }
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$pb",
        "within_ms": 300
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "the peer is still there"
    },
    {
      "on": "a",
      "op": "conn.close",
      "args": {
        "on": "$ca",
        "code": 1000,
        "reason": "done"
      }
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$pb"
      },
      "expect": {
        "clean": true
      },
      "note": "and ends cleanly when the raw side chooses to, so the frame did the connection no harm"
    }
  ]
}
