{
  "name": "a peer's close is clean on both sides when a side chose it, and not when the transport failed",
  "layer": "peer",
  "needs": ["peer", "seam", "listen"],
  "steps": [
    {"on": "a", "op": "peer.listen", "bind": {"handle": "l", "url": "url"}},
    {"on": "b", "op": "peer.dial", "args": {"url": "$url"}, "bind": "pb"},
    {"on": "a", "op": "peer.accept", "args": {"on": "$l"}, "bind": "pa"},
    {"on": "b", "op": "peer.close", "args": {"on": "$pb"}},
    {"on": "b", "op": "peer.await_close", "args": {"on": "$pb"}, "expect": {"clean": true}},
    {"on": "a", "op": "peer.await_close", "args": {"on": "$pa"}, "expect": {"clean": "$bool"}, "note": "how a chosen close reaches the remote is the transport's: a clean close frame, or an abort"},
    {"on": "a", "op": "peer.listen", "bind": {"handle": "l2", "url": "url2"}},
    {"on": "b", "op": "conn.dial", "args": {"url": "$url2"}, "bind": "cb"},
    {"on": "a", "op": "peer.accept", "args": {"on": "$l2"}, "bind": "pa2"},
    {"on": "b", "op": "conn.abort", "args": {"on": "$cb"}},
    {"on": "a", "op": "peer.await_close", "args": {"on": "$pa2"}, "expect": {"clean": false}, "note": "a transport that broke is not a close anyone chose"}
  ]
}
