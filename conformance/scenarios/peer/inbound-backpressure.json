{
  "name": "events beyond what a peer holds while its handler blocks are backpressure, told to the observer, and end the stalled peer",
  "layer": "peer",
  "replaces": "runtime/go/backpressure_test.go's inbound queue case and runtime/ts/src/peer.test.ts's",
  "needs": [
    "observer",
    "peer"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a",
        "server_options": {
          "observe": true,
          "queue_capacity": 1,
          "write_timeout_ms": 500
        }
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "peer.on_event",
      "args": {
        "on": "$pa",
        "name": "flood",
        "behavior": {
          "kind": "block"
        }
      }
    },
    {
      "on": "b",
      "op": "peer.emit",
      "args": {
        "on": "$pb",
        "event": "flood",
        "data": 1
      }
    },
    {
      "on": "b",
      "op": "peer.emit",
      "args": {
        "on": "$pb",
        "event": "flood",
        "data": 2
      }
    },
    {
      "on": "b",
      "op": "peer.emit",
      "args": {
        "on": "$pb",
        "event": "flood",
        "data": 3
      },
      "expect": "$any",
      "expect_error": {
        "code": "$any"
      },
      "note": "the stalled side ends within its write deadline; a sender's emit past the stall succeeds or fails as its runtime reports a send, so the step holds either"
    },
    {
      "on": "b",
      "op": "peer.emit",
      "args": {
        "on": "$pb",
        "event": "flood",
        "data": 4
      },
      "repeat": {
        "max": 8,
        "until": "error"
      },
      "expect": "$any",
      "expect_error": {
        "code": "$any"
      }
    },
    {
      "on": "a",
      "op": "peer.await_close",
      "args": {
        "on": "$pa"
      },
      "expect": {
        "clean": false
      }
    },
    {
      "on": "a",
      "op": "peer.observed",
      "args": {
        "on": "$pa"
      },
      "expect": {
        "$contains": [
          {
            "type": "backpressure",
            "queued": "$int",
            "stalled": true,
            "deadline": true
          }
        ]
      }
    }
  ]
}
