{
  "name": "a request carries a trace, its response carries the same, and what a handler does from it is a child of it",
  "layer": "peer",
  "replaces": "runtime/go/trace tests and runtime/ts/src/trace.test.ts, across the wire",
  "needs": [
    "peer",
    "listen",
    "observer",
    "propagator"
  ],
  "steps": [
    {
      "on": "a",
      "op": "peer.listen",
      "args": {
        "options": {
          "observe": true,
          "propagate": true
        }
      },
      "bind": {
        "handle": "l",
        "url": "url"
      }
    },
    {
      "on": "b",
      "op": "peer.dial",
      "args": {
        "url": "$url",
        "options": {
          "observe": true,
          "propagate": true
        }
      },
      "bind": "pb"
    },
    {
      "on": "a",
      "op": "peer.accept",
      "args": {
        "on": "$l"
      },
      "bind": "pa"
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$pa",
        "method": "roundtrip",
        "behavior": {
          "kind": "reverse",
          "method": "back",
          "params": {}
        }
      }
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$pa",
        "method": "notify",
        "behavior": {
          "kind": "emit",
          "event": "notice",
          "data": 1,
          "then": "notified"
        }
      }
    },
    {
      "on": "b",
      "op": "peer.handle",
      "args": {
        "on": "$pb",
        "method": "back",
        "behavior": {
          "kind": "return",
          "value": "back"
        }
      }
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$pb",
        "method": "roundtrip",
        "params": {}
      },
      "bind": "c1"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c1"
      },
      "expect": {
        "result": "back"
      }
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$pb",
        "method": "notify",
        "params": {}
      },
      "bind": "c2"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c2"
      },
      "expect": {
        "result": "notified"
      }
    },
    {
      "on": "b",
      "op": "peer.await_event",
      "args": {
        "on": "$pb",
        "name": "notice"
      }
    },
    {
      "on": "b",
      "op": "peer.observed",
      "args": {
        "on": "$pb",
        "trace": true
      },
      "expect": {
        "$contains": [
          {
            "type": "frame.sent",
            "kind": "request",
            "name": "roundtrip",
            "trace": {
              "trace_id": "$bind:t",
              "span_id": "$bind:s",
              "flags": "01"
            }
          },
          {
            "type": "frame.received",
            "kind": "request",
            "name": "back",
            "trace": {
              "trace_id": "$t",
              "span_id": "$not:s"
            }
          },
          {
            "type": "frame.sent",
            "kind": "response",
            "trace": {
              "trace_id": "$t",
              "span_id": "$bind:child"
            }
          },
          {
            "type": "frame.received",
            "kind": "response",
            "trace": {
              "trace_id": "$t",
              "span_id": "$s"
            }
          },
          {
            "type": "frame.sent",
            "kind": "request",
            "name": "notify",
            "trace": {
              "trace_id": "$bind:t2",
              "span_id": "$bind:s2"
            }
          },
          {
            "type": "frame.received",
            "kind": "event",
            "name": "notice",
            "trace": {
              "trace_id": "$t2",
              "span_id": "$not:s2"
            }
          },
          {
            "type": "frame.received",
            "kind": "response",
            "trace": {
              "trace_id": "$t2",
              "span_id": "$s2"
            }
          }
        ]
      },
      "note": "the call back is a child of the request that made it: the same trace, another span; the response carries the request's members; a second call is a new trace"
    },
    {
      "on": "a",
      "op": "peer.observed",
      "args": {
        "on": "$pa",
        "trace": true
      },
      "expect": {
        "$contains": [
          {
            "type": "frame.received",
            "kind": "request",
            "name": "roundtrip",
            "trace": {
              "trace_id": "$t",
              "span_id": "$s"
            }
          },
          {
            "type": "frame.sent",
            "kind": "request",
            "name": "back",
            "trace": {
              "trace_id": "$t",
              "span_id": "$child"
            }
          },
          {
            "type": "frame.received",
            "kind": "response",
            "trace": {
              "trace_id": "$t",
              "span_id": "$child"
            }
          },
          {
            "type": "frame.sent",
            "kind": "response",
            "trace": {
              "trace_id": "$t",
              "span_id": "$s"
            }
          },
          {
            "type": "frame.sent",
            "kind": "event",
            "name": "notice",
            "trace": {
              "trace_id": "$t2",
              "span_id": "$not:s2"
            }
          }
        ]
      }
    },
    {
      "on": "b",
      "op": "peer.observed",
      "args": {
        "on": "$pb",
        "trace": true
      },
      "expect": [],
      "note": "observed drains"
    }
  ]
}
