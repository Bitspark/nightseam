{
  "name": "generated session callbacks receive initial control before replay, and later transfer and release",
  "layer": "generated",
  "needs": [
    "generated"
  ],
  "mirror": true,
  "steps": [
    {
      "on": "a",
      "op": "gen.serve",
      "args": {
        "session": true
      },
      "bind": {
        "handle": "srv",
        "url": "url"
      }
    },
    {
      "on": "b",
      "op": "gen.dial",
      "args": {
        "url": "$url"
      },
      "bind": "first"
    },
    {
      "on": "b",
      "op": "client.await_notification",
      "args": {
        "on": "$first"
      },
      "expect": {
        "event": "session.control",
        "data": {
          "holder": null
        }
      }
    },
    {
      "on": "b",
      "op": "client.await_notification",
      "args": {
        "on": "$first"
      },
      "expect": {
        "event": "changed",
        "data": {
          "text": "replay",
          "count": 1
        }
      }
    },
    {
      "on": "a",
      "op": "server.control",
      "args": {
        "on": "$srv",
        "origin": "consumer1"
      }
    },
    {
      "on": "b",
      "op": "client.await_notification",
      "args": {
        "on": "$first"
      },
      "expect": {
        "event": "session.control",
        "data": {
          "holder": "consumer1"
        }
      }
    },
    {
      "on": "b",
      "op": "gen.dial",
      "args": {
        "url": "$url",
        "control": false
      },
      "bind": "second"
    },
    {
      "on": "b",
      "op": "client.await_notification",
      "args": {
        "on": "$second"
      },
      "expect": {
        "event": "changed",
        "data": {
          "text": "replay",
          "count": 1
        }
      },
      "note": "Replay proves the initial unhandled control has passed before later registration."
    },
    {
      "on": "b",
      "op": "client.on_control",
      "args": {
        "on": "$second"
      }
    },
    {
      "on": "a",
      "op": "server.control",
      "args": {
        "on": "$srv",
        "origin": "consumer2"
      }
    },
    {
      "on": "b",
      "op": "client.await_notification",
      "args": {
        "on": "$first"
      },
      "expect": {
        "event": "session.control",
        "data": {
          "holder": "consumer2"
        }
      }
    },
    {
      "on": "b",
      "op": "client.await_notification",
      "args": {
        "on": "$second"
      },
      "expect": {
        "event": "session.control",
        "data": {
          "holder": "consumer2"
        }
      }
    },
    {
      "on": "a",
      "op": "server.control",
      "args": {
        "on": "$srv",
        "origin": null
      }
    },
    {
      "on": "b",
      "op": "client.await_notification",
      "args": {
        "on": "$first"
      },
      "expect": {
        "event": "session.control",
        "data": {
          "holder": null
        }
      }
    },
    {
      "on": "b",
      "op": "client.await_notification",
      "args": {
        "on": "$second"
      },
      "expect": {
        "event": "session.control",
        "data": {
          "holder": null
        }
      }
    },
    {
      "on": "b",
      "op": "client.close",
      "args": {
        "on": "$second"
      }
    },
    {
      "on": "b",
      "op": "client.close",
      "args": {
        "on": "$first"
      }
    }
  ]
}
