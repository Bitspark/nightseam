{
  "name": "a channel opened from either side is accepted with its family and its after, carries a peer, and its id says who opened it",
  "layer": "tunnel",
  "replaces": "tunnel/go/interop_test.go with tunnel/ts/src/interop.ts",
  "needs": [
    "tunnel",
    "peer",
    "listen"
  ],
  "steps": [
    {
      "on": "a",
      "op": "peer.listen",
      "args": {
        "options": {
          "observe": true
        }
      },
      "bind": {
        "handle": "l",
        "url": "url"
      }
    },
    {
      "on": "b",
      "op": "peer.dial",
      "args": {
        "url": "$url",
        "options": {
          "observe": true
        }
      },
      "bind": "pb"
    },
    {
      "on": "a",
      "op": "peer.accept",
      "args": {
        "on": "$l"
      },
      "bind": "pa"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "ta"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "tb"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$tb",
        "family": "probe",
        "after": 3
      },
      "bind": {
        "handle": "cb",
        "id": "opened"
      },
      "expect": {
        "id": "$odd"
      },
      "note": "the client peer's tunnel mints odd ids"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$ta"
      },
      "bind": {
        "handle": "ca"
      },
      "expect": {
        "id": "$opened",
        "family": "probe",
        "after": 3
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$ca",
        "role": "server"
      },
      "bind": "sa"
    },
    {
      "on": "b",
      "op": "peer.over",
      "args": {
        "on": "$cb",
        "role": "client"
      },
      "bind": "sb"
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$sa",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$sb",
        "method": "echo",
        "params": {
          "over": "a channel"
        }
      },
      "bind": "c1"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c1"
      },
      "expect": {
        "result": {
          "over": "a channel"
        }
      }
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$ta",
        "family": "codex",
        "after": 11
      },
      "bind": {
        "handle": "ca2",
        "id": "opened2"
      },
      "expect": {
        "id": "$even"
      },
      "note": "the server peer's tunnel mints even ids"
    },
    {
      "on": "b",
      "op": "tunnel.accept",
      "args": {
        "on": "$tb"
      },
      "bind": {
        "handle": "cb2"
      },
      "expect": {
        "id": "$opened2",
        "family": "codex",
        "after": 11
      }
    },
    {
      "on": "b",
      "op": "peer.over",
      "args": {
        "on": "$cb2",
        "role": "server"
      },
      "bind": "sb2"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$ca2",
        "role": "client"
      },
      "bind": "sa2"
    },
    {
      "on": "b",
      "op": "peer.handle",
      "args": {
        "on": "$sb2",
        "method": "multiply",
        "behavior": {
          "kind": "return",
          "value": {
            "value": 21
          }
        }
      }
    },
    {
      "on": "a",
      "op": "peer.call",
      "args": {
        "on": "$sa2",
        "method": "multiply",
        "params": {
          "value": 7
        }
      },
      "bind": "c2"
    },
    {
      "on": "a",
      "op": "call.await",
      "args": {
        "on": "$c2"
      },
      "expect": {
        "result": {
          "value": 21
        }
      }
    },
    {
      "on": "a",
      "op": "peer.emit",
      "args": {
        "on": "$sa",
        "event": "done",
        "data": {
          "ok": true
        }
      }
    },
    {
      "on": "b",
      "op": "peer.await_event",
      "args": {
        "on": "$sb",
        "name": "done"
      },
      "expect": {
        "data": {
          "ok": true
        }
      }
    },
    {
      "on": "a",
      "op": "peer.observed",
      "args": {
        "on": "$pa"
      },
      "expect": {
        "$contains": [
          {
            "type": "channel.accepted",
            "family": "probe",
            "id": "$opened",
            "after": 3
          },
          {
            "type": "channel.opened",
            "family": "codex",
            "id": "$opened2",
            "after": 11,
            "opener": true
          }
        ]
      }
    },
    {
      "on": "b",
      "op": "peer.observed",
      "args": {
        "on": "$pb"
      },
      "expect": {
        "$contains": [
          {
            "type": "channel.opened",
            "family": "probe",
            "id": "$opened",
            "after": 3,
            "opener": true
          },
          {
            "type": "channel.accepted",
            "family": "codex",
            "id": "$opened2",
            "after": 11
          }
        ]
      }
    }
  ]
}
