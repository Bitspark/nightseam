{
  "name": "a sender past the receiver's window waits for credit, which the observer sees as a stall, and goes on when the receiver reads",
  "layer": "tunnel",
  "replaces": "tunnel/go/observer_test.go's stall case and tunnel/ts/src/tunnel.test.ts's",
  "needs": [
    "tunnel",
    "peer",
    "listen",
    "lazy"
  ],
  "steps": [
    {
      "on": "a",
      "op": "peer.listen",
      "args": {
        "options": {
          "observe": true
        }
      },
      "bind": {
        "handle": "l",
        "url": "url"
      }
    },
    {
      "on": "b",
      "op": "peer.dial",
      "args": {
        "url": "$url",
        "options": {
          "observe": true
        }
      },
      "bind": "pb"
    },
    {
      "on": "a",
      "op": "peer.accept",
      "args": {
        "on": "$l"
      },
      "bind": "pa"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa",
        "options": {
          "window": 2
        }
      },
      "bind": "ta"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb",
        "options": {
          "window": 2
        }
      },
      "bind": "tb"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$tb",
        "family": "probe",
        "consume": "lazy"
      },
      "bind": {
        "handle": "cb",
        "id": "id"
      }
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$ta",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ca"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "1"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "2"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "3",
        "within_ms": 300
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "the window is two and nobody reads: the third send waits"
    },
    {
      "on": "b",
      "op": "peer.observed",
      "args": {
        "on": "$pb"
      },
      "expect": {
        "$contains": [
          {
            "type": "credit.stall",
            "family": "probe",
            "id": "$id",
            "waiting": 1
          }
        ]
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": "1"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": "2"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "3"
      },
      "note": "a send that timed out was given up; with the reader caught up and credit returned, the next goes through"
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": "3"
      }
    }
  ]
}
