{
  "name": "a session bound over a log that already holds frames is bound at its head, and replays them to a consumer that attaches before the machine has spoken",
  "layer": "session",
  "needs": [
    "lazy",
    "peer",
    "pipe",
    "seam",
    "session",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "carrier_a"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "carrier_b"
    },
    {
      "on": "a",
      "op": "conn.pipe",
      "args": {
        "consume": "lazy"
      },
      "bind": {
        "a": "pipe_near",
        "b": "pipe_far"
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_near",
        "role": "client"
      },
      "bind": "near"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_far",
        "role": "server"
      },
      "bind": "far"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$near"
      },
      "bind": "tunnel_near"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$far"
      },
      "bind": "tunnel_far"
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$tunnel_far",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "machine"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$tunnel_near",
        "consume": "lazy"
      },
      "bind": "up"
    },
    {
      "on": "a",
      "op": "session.new",
      "bind": "reg"
    },
    {
      "on": "a",
      "op": "session.bind",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$up",
        "governance": {
          "decides": [
            "echo"
          ],
          "asks": [
            "reverse"
          ]
        },
        "log": {
          "max_frame_bytes": 1048576,
          "prefill": [
            {
              "direction": "down",
              "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":1}"
            },
            {
              "direction": "down",
              "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":2}"
            },
            {
              "direction": "down",
              "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":3}"
            }
          ]
        }
      },
      "note": "the log already holds three frames, as a durable one does after the process that wrote them ended"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "all"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_all"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_all",
        "role": "observer",
        "origin": "all",
        "after": 0
      },
      "bind": "att_all"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$all"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$all"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":1}"
      },
      "note": "a consumer resuming from nothing is given the log's frames, before the machine has spoken at all"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$all"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":1}}"
      },
      "note": "the cursor is the log's own sequence, which a consumer resumes from"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$all"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":2}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$all"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":2}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$all"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":3}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$all"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":3}}"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "late"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_late"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_late",
        "role": "observer",
        "origin": "late",
        "after": 1
      },
      "bind": "att_late"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":2}"
      },
      "note": "and one holding the first frame takes the two after it, and no more"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":2}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":3}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":3}}"
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":4}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$all"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":4}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$all"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":4}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":4}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":4}}"
      }
    },
    {
      "on": "a",
      "op": "session.changes",
      "args": {
        "on": "$reg"
      },
      "expect": {
        "$contains": [
          {
            "kind": "frame_appended",
            "sequence": 4
          }
        ]
      },
      "note": "the session went on from the log's head: the machine's first frame is the fourth, not the first"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "after"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_after"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_after",
        "role": "observer",
        "origin": "after",
        "after": 3
      },
      "bind": "att_after"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$after"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$after"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":4}"
      },
      "note": "a consumer holding the whole log is replayed nothing of it and given what came after"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$after"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":4}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$after",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      }
    }
  ]
}
