{
  "name": "a binary frame ends the connection it arrived on as unsupported data, from a consumer and from the machine",
  "layer": "session",
  "replaces": "session/go/sessiontest and session/ts/src/conformance.ts, across the wire",
  "description": "A session speaks JSON text frames. A frame of another kind carries no message of the profile at all, which is 1003 \u2014 unsupported data \u2014 and not the 1008 that text which is no message of the profile is refused with. Either side may send one: a consumer's ends its own connection and leaves the session standing, the machine's ends the session and every consumer with it, and both carry the same reason.",
  "needs": [
    "lazy",
    "peer",
    "pipe",
    "seam",
    "session",
    "tunnel"
  ],
  "mirror": true,
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "carrier_a"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "carrier_b"
    },
    {
      "on": "a",
      "op": "conn.pipe",
      "args": {
        "consume": "lazy"
      },
      "bind": {
        "a": "pipe_near",
        "b": "pipe_far"
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_near",
        "role": "client"
      },
      "bind": "near"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_far",
        "role": "server"
      },
      "bind": "far"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$near"
      },
      "bind": "tunnel_near"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$far"
      },
      "bind": "tunnel_far"
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$tunnel_far",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "machine"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$tunnel_near",
        "consume": "lazy"
      },
      "bind": "up"
    },
    {
      "on": "a",
      "op": "session.new",
      "bind": "reg"
    },
    {
      "on": "a",
      "op": "session.bind",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$up",
        "governance": {
          "decides": [
            "echo"
          ],
          "asks": [
            "reverse"
          ]
        }
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "eager"
      },
      "bind": "one"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_one"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_one",
        "role": "participant",
        "origin": "one",
        "after": 0
      },
      "bind": "att_one"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "eager"
      },
      "bind": "two"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_two"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_two",
        "role": "observer",
        "origin": "watcher",
        "after": 0
      },
      "bind": "att_watcher"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      },
      "note": "Who holds control is the first frame on a consumer's connection, taken here so that the quiet below reads a connection with nothing on it."
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$one",
        "kind": "binary",
        "base64": "AAE="
      },
      "note": "A frame of the wrong kind on a consumer's connection: it carries no message of the profile at all, which is unsupported data and not a message the profile refuses."
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$one"
      },
      "expect": {
        "code": 1003,
        "reason": "a session speaks JSON text frames"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "The session stands: the consumer that sent the frame is the only one ended by it."
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":{\"text\":\"still here\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:\"event\":\"changed\""
      },
      "note": "And it goes on routing."
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:\"event\":\"session.cursor\""
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "binary",
        "base64": "Ag=="
      },
      "note": "The machine's own ends the session, and every consumer with it, under the same code and the same reason."
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$two"
      },
      "expect": {
        "code": 1003,
        "reason": "a session speaks JSON text frames"
      }
    },
    {
      "on": "a",
      "op": "conn.await_close",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "code": 1003,
        "reason": "a session speaks JSON text frames"
      }
    }
  ]
}
