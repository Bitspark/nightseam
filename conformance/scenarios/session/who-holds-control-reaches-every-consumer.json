{
  "name": "who holds control reaches every consumer as the session's own event: on attach before the replay, on every change, and never from the machine",
  "layer": "session",
  "replaces": "session/go/sessiontest and session/ts/src/conformance.ts, across the wire",
  "needs": [
    "lazy",
    "peer",
    "pipe",
    "seam",
    "session",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "carrier_a"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "carrier_b"
    },
    {
      "on": "a",
      "op": "conn.pipe",
      "args": {
        "consume": "lazy"
      },
      "bind": {
        "a": "pipe_near",
        "b": "pipe_far"
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_near",
        "role": "client"
      },
      "bind": "near"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_far",
        "role": "server"
      },
      "bind": "far"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$near"
      },
      "bind": "tunnel_near"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$far"
      },
      "bind": "tunnel_far"
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$tunnel_far",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "machine"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$tunnel_near",
        "consume": "lazy"
      },
      "bind": "up"
    },
    {
      "on": "a",
      "op": "session.new",
      "bind": "reg"
    },
    {
      "on": "a",
      "op": "session.bind",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$up",
        "governance": {
          "decides": [
            "echo"
          ],
          "asks": [
            "reverse"
          ]
        }
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "one"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_one"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_one",
        "role": "participant",
        "origin": "one",
        "after": 0
      },
      "bind": "att_one"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      },
      "note": "a consumer that joins a session nobody holds is told exactly that, before anything else on its connection"
    },
    {
      "on": "a",
      "op": "attachment.state",
      "args": {
        "on": "$att_one"
      },
      "expect": {
        "holder": null,
        "sequence": 0
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "two"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_two"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_two",
        "role": "participant",
        "origin": "two",
        "after": 0
      },
      "bind": "att_two"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "s",
        "attachment": "$att_one"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      },
      "note": "control moving is told to every consumer, the one it moved to and the ones it did not"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "a",
      "op": "attachment.state",
      "args": {
        "on": "$att_one"
      },
      "expect": {
        "holder": "one",
        "sequence": 0
      }
    },
    {
      "on": "a",
      "op": "attachment.state",
      "args": {
        "on": "$att_two"
      },
      "expect": {
        "holder": "one",
        "sequence": 0
      },
      "note": "the attachment says what the relay told its consumer, so the two agree"
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "s",
        "attachment": null
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      },
      "note": "released, control stands with nobody, which an origin alone could not say of a consumer attached under no name"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "a",
      "op": "attachment.state",
      "args": {
        "on": "$att_one"
      },
      "expect": {
        "holder": null,
        "sequence": 0
      }
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "s",
        "attachment": "$att_one"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":1}"
      },
      "note": "one frame of the family, so that a consumer attaching after it has a replay"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":1}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":1}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":1}}"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "three"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_three"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_three",
        "role": "observer",
        "origin": "three",
        "after": 0
      },
      "bind": "att_three"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$three"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      },
      "note": "a consumer attaching is told the holder it joined before any replayed or live frame"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$three"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":1}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$three"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":1}}"
      }
    },
    {
      "on": "a",
      "op": "attachment.state",
      "args": {
        "on": "$att_three"
      },
      "expect": {
        "holder": "one",
        "sequence": 1
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"three\"}}"
      },
      "note": "the vocabulary is the relay's to produce: a machine speaking it speaks for the layer above it"
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$one"
      },
      "expect": {
        "code": 1002,
        "reason": "a machine does not send session.control"
      }
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$two"
      },
      "expect": {
        "code": 1002,
        "reason": "a machine does not send session.control"
      }
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$three"
      },
      "expect": {
        "code": 1002,
        "reason": "a machine does not send session.control"
      }
    }
  ]
}
