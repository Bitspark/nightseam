{
  "name": "a consumer resumes from the cursor the relay told it, which is the log's own sequence and not a count of what arrived",
  "layer": "session",
  "replaces": "session/go/sessiontest and session/ts/src/conformance.ts, across the wire",
  "needs": [
    "lazy",
    "peer",
    "pipe",
    "seam",
    "session",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "carrier_a"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "carrier_b"
    },
    {
      "on": "a",
      "op": "conn.pipe",
      "args": {
        "consume": "lazy"
      },
      "bind": {
        "a": "pipe_near",
        "b": "pipe_far"
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_near",
        "role": "client"
      },
      "bind": "near"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_far",
        "role": "server"
      },
      "bind": "far"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$near"
      },
      "bind": "tunnel_near"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$far"
      },
      "bind": "tunnel_far"
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$tunnel_far",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "machine"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$tunnel_near",
        "consume": "lazy"
      },
      "bind": "up"
    },
    {
      "on": "a",
      "op": "session.new",
      "bind": "reg"
    },
    {
      "on": "a",
      "op": "session.bind",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$up",
        "governance": {
          "decides": [
            "echo"
          ],
          "asks": [
            "reverse"
          ]
        },
        "log": {
          "max_frame_bytes": 60,
          "prefill": [
            {
              "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":1}"
            },
            {
              "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":{\"text\":\"well beyond the bound this log was given\"}}"
            },
            {
              "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":3}"
            },
            {
              "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":4}"
            }
          ]
        }
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "eager"
      },
      "bind": "watcher"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_watcher"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_watcher",
        "role": "observer",
        "origin": "watcher",
        "after": 4
      },
      "bind": "att_watcher",
      "note": "a consumer holding the whole log, replayed nothing, which is where the scenario reads that a live frame was recorded"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$watcher"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$watcher",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "eager"
      },
      "bind": "one"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_one"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_one",
        "role": "observer",
        "origin": "one",
        "after": 0
      },
      "bind": "att_one"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":1}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":3}"
      },
      "note": "the frame the log kept cut is delivered as nothing, and the cursor after the one that follows it names its own sequence"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":3}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":4}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":4}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      }
    },
    {
      "on": "a",
      "op": "attachment.state",
      "args": {
        "on": "$att_one"
      },
      "expect": {
        "holder": null,
        "sequence": 4
      },
      "note": "three frames arrived and the session stands at four: a consumer counting what arrived would stand one short"
    },
    {
      "on": "a",
      "op": "attachment.detach",
      "args": {
        "on": "$att_one"
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":5}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$watcher"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":5}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$watcher"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":5}}"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "eager"
      },
      "bind": "again"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_again"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_again",
        "role": "observer",
        "origin": "again",
        "after": 4
      },
      "bind": "att_again",
      "note": "the same consumer back, resuming after the cursor it was told"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$again"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$again"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":5}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$again"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":5}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$again",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "exactly what came after the cursor, and nothing it already held"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "eager"
      },
      "bind": "counted"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_counted"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_counted",
        "role": "observer",
        "origin": "counted",
        "after": 3
      },
      "bind": "att_counted",
      "note": "and one resuming after what it counted itself"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$counted"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$counted"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":4}"
      },
      "note": "the fourth frame a second time, which is what a counted cursor gets wrong"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$counted"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":4}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$counted"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":5}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$counted"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":5}}"
      }
    }
  ]
}
