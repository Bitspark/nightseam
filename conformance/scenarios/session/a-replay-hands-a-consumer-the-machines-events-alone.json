{
  "name": "a replay hands a consumer the machine's events alone, and the cursor passes the frames it was not given",
  "layer": "session",
  "replaces": "session/go/sessiontest and session/ts/src/conformance.ts, across the wire",
  "needs": [
    "lazy",
    "peer",
    "pipe",
    "seam",
    "session",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "carrier_a"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "carrier_b"
    },
    {
      "on": "a",
      "op": "conn.pipe",
      "args": {
        "consume": "lazy"
      },
      "bind": {
        "a": "pipe_near",
        "b": "pipe_far"
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_near",
        "role": "client"
      },
      "bind": "near"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_far",
        "role": "server"
      },
      "bind": "far"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$near"
      },
      "bind": "tunnel_near"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$far"
      },
      "bind": "tunnel_far"
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$tunnel_far",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "machine"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$tunnel_near",
        "consume": "lazy"
      },
      "bind": "up"
    },
    {
      "on": "a",
      "op": "session.new",
      "bind": "reg"
    },
    {
      "on": "a",
      "op": "session.bind",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$up",
        "governance": {
          "decides": [
            "echo"
          ],
          "asks": [
            "reverse"
          ]
        }
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "eager"
      },
      "bind": "one"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_one"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_one",
        "role": "participant",
        "origin": "one",
        "after": 0
      },
      "bind": "att_one"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "s",
        "attachment": "$att_one"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$one",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:7\",\"method\":\"echo\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"echo\",\"params\":{\"text\":\"t\",\"count\":1}}"
      },
      "note": "the request goes up under an id of the session's own, which is the id the log keeps"
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"c:1\",\"result\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"c:7\",\"result\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":2}}"
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\",\"data\":{\"text\":\"one\",\"count\":1},\"tracestate\":\"nightseam=replay\",\"meta\":{\"tenant\":\"acme\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\",\"data\":{\"text\":\"one\",\"count\":1},\"tracestate\":\"nightseam=replay\",\"meta\":{\"tenant\":\"acme\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":3}}"
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"method\":\"reverse\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"method\":\"reverse\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":4}}"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$one",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":{\"text\":\"two\",\"count\":2}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":{\"text\":\"two\",\"count\":2}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":6}}"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "eager"
      },
      "bind": "two"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_two"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_two",
        "role": "observer",
        "origin": "two",
        "after": 0
      },
      "bind": "att_two"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\",\"data\":{\"text\":\"one\",\"count\":1},\"tracestate\":\"nightseam=replay\",\"meta\":{\"tenant\":\"acme\"}}"
      },
      "note": "the first frame of the replay is the log's third, byte for byte with its carriage: the request that went up and the response that came down to the consumer that sent it are no frames for this channel"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":3}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"data\":{\"text\":\"two\",\"count\":2}}"
      },
      "note": "and the request the machine asked of the holder, and the answer that went up, are passed over as well"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":6}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      }
    },
    {
      "on": "a",
      "op": "attachment.state",
      "args": {
        "on": "$att_two"
      },
      "expect": {
        "holder": "one",
        "sequence": 6
      },
      "note": "two frames arrived and the session stands at six: the cursor passes what the channel was not given"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$one",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"noticed\",\"data\":{\"text\":\"seen\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"noticed\",\"data\":{\"text\":\"seen\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "eager"
      },
      "bind": "three"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_three"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_three",
        "role": "observer",
        "origin": "three",
        "after": 6
      },
      "bind": "att_three"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$three"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$three"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":7}}"
      },
      "note": "a replay that gave nothing still says where it reached, so that resuming from this cursor reads the log on rather than over the frame it was never given"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$three",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "after": 0,
        "consume": "lazy"
      },
      "bind": "four"
    },
    {
      "on": "b",
      "op": "peer.over",
      "args": {
        "on": "$four",
        "role": "client"
      },
      "bind": "consumer",
      "note": "a consumer's peer is the client side of the family, so it mints c:N and ends the connection on a request that carries one"
    },
    {
      "on": "b",
      "op": "peer.on_event",
      "args": {
        "on": "$consumer",
        "name": "changed"
      }
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_four"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_four",
        "role": "observer",
        "origin": "four",
        "after": 0
      },
      "bind": "att_four"
    },
    {
      "on": "b",
      "op": "peer.await_event",
      "args": {
        "on": "$consumer",
        "name": "changed"
      },
      "expect": {
        "data": {
          "text": "one",
          "count": 1
        },
        "meta": {
          "tenant": "acme"
        }
      },
      "note": "the carriage the machine sent the event with reaches the peer of the consumer replayed it"
    },
    {
      "on": "b",
      "op": "peer.await_event",
      "args": {
        "on": "$consumer",
        "name": "changed"
      },
      "expect": {
        "data": {
          "text": "two",
          "count": 2
        }
      }
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$consumer",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "the replay handed it nothing it had to refuse, so the connection it joined on is still there"
    }
  ]
}
