{
  "name": "a deciding frame is the holder's alone: an observer's and a non-holding participant's are refused with not_controlling, a cancel decides, and an answer to an ask decides",
  "layer": "session",
  "replaces": "session/go/sessiontest and session/ts/src/conformance.ts, across the wire",
  "needs": [
    "lazy",
    "peer",
    "pipe",
    "seam",
    "session",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "carrier_a"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "carrier_b"
    },
    {
      "on": "a",
      "op": "conn.pipe",
      "args": {
        "consume": "lazy"
      },
      "bind": {
        "a": "pipe_near",
        "b": "pipe_far"
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_near",
        "role": "client"
      },
      "bind": "near"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_far",
        "role": "server"
      },
      "bind": "far"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$near"
      },
      "bind": "tunnel_near"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$far"
      },
      "bind": "tunnel_far"
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$tunnel_far",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "machine"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$tunnel_near",
        "consume": "lazy"
      },
      "bind": "up"
    },
    {
      "on": "a",
      "op": "session.new",
      "bind": "reg"
    },
    {
      "on": "a",
      "op": "session.bind",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$up",
        "governance": {
          "decides": [
            "echo"
          ],
          "asks": [
            "reverse"
          ]
        }
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "first"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_first"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_first",
        "role": "participant",
        "origin": "first",
        "after": 0
      },
      "bind": "att_first"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$first"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      },
      "note": "every consumer is told who holds control before anything else on its connection"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "second"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_second"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_second",
        "role": "participant",
        "origin": "second",
        "after": 0
      },
      "bind": "att_second"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$second"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "watcher"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_watcher"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_watcher",
        "role": "observer",
        "origin": "watcher",
        "after": 0
      },
      "bind": "att_watcher"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$watcher"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$watcher",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"echo\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$watcher"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:^\\{\"version\":1,\"kind\":\"response\",\"id\":\"c:1\",\"error\":\\{\"code\":\"not_controlling\""
      },
      "note": "an observer's deciding request is answered in the machine's place"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$second",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"echo\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$second"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:^\\{\"version\":1,\"kind\":\"response\",\"id\":\"c:1\",\"error\":\\{\"code\":\"not_controlling\""
      },
      "note": "and so is a participant's that does not hold control"
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "the machine saw neither"
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "s",
        "attachment": "$att_first"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$first"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"first\"}}"
      },
      "note": "control moving is told to every consumer, the one it moved to and the ones it did not"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$second"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"first\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$watcher"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"first\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$first",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"echo\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:^\\{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"echo\""
      },
      "note": "the holder's goes through, under the session's own id"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$second",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"cancel\",\"id\":\"c:1\"}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "a cancel decides: one from a consumer that does not hold control is dropped"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$first",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"cancel\",\"id\":\"c:1\"}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:^\\{\"version\":1,\"kind\":\"cancel\",\"id\":\"c:1\"\\}$"
      },
      "note": "the holder's reaches the machine under the id the session asked with"
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"method\":\"reverse\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$first"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"method\":\"reverse\",\"params\":{\"text\":\"t\",\"count\":1}}"
      },
      "note": "the ask reaches the holder"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$first"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":3}}"
      },
      "note": "the ask stood third in the session's one order, two frames of the holder's having gone up before it"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$second",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"other\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "an answer from one that does not hold control is dropped"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$first",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"held\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"held\",\"count\":1}}"
      },
      "note": "the holder's answer decides"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$watcher",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"noticed\",\"data\":{\"text\":\"n\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"noticed\",\"data\":{\"text\":\"n\",\"count\":1}}"
      },
      "note": "an event decides nothing, so anyone attached may send one"
    }
  ]
}
