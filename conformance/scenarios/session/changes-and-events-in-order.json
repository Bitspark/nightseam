{
  "name": "every domain change reaches the registry's hook and the observer of the peer the machine speaks over, in order",
  "layer": "session",
  "replaces": "session/go/sessiontest's OnChange case and session/ts/src/conformance.ts's, across the wire",
  "needs": [
    "lazy",
    "observer",
    "peer",
    "pipe",
    "seam",
    "session",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a",
        "server_options": {
          "observe": true
        }
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "carrier_a"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "carrier_b"
    },
    {
      "on": "a",
      "op": "conn.pipe",
      "args": {
        "consume": "lazy"
      },
      "bind": {
        "a": "pipe_near",
        "b": "pipe_far"
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_near",
        "role": "client",
        "options": {
          "observe": true
        }
      },
      "bind": "near"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_far",
        "role": "server"
      },
      "bind": "far"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$near"
      },
      "bind": "tunnel_near"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$far"
      },
      "bind": "tunnel_far"
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$tunnel_far",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "machine"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$tunnel_near",
        "consume": "lazy"
      },
      "bind": "up"
    },
    {
      "on": "a",
      "op": "session.new",
      "bind": "reg"
    },
    {
      "on": "a",
      "op": "session.bind",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$up",
        "governance": {
          "decides": [
            "echo"
          ],
          "asks": [
            "reverse"
          ]
        }
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "one"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_one"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_one",
        "role": "participant",
        "origin": "one",
        "after": 0
      },
      "bind": "att_one"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "two"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_two"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "s",
        "channel": "$ch_two",
        "role": "participant",
        "origin": "two",
        "after": 0
      },
      "bind": "att_two"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "s",
        "attachment": "$att_one"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$one",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"echo\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:\"method\":\"echo\""
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$two",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"echo\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:not_controlling"
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"method\":\"reverse\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"method\":\"reverse\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":2}}"
      }
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "s",
        "attachment": "$att_two"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"two\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"two\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"method\":\"reverse\",\"params\":{\"text\":\"t\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$two",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"held\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"held\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "attachment.detach",
      "args": {
        "on": "$att_one"
      }
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$one"
      },
      "expect": {
        "code": "$int"
      }
    },
    {
      "on": "a",
      "op": "conn.close",
      "args": {
        "on": "$machine",
        "code": 4002,
        "reason": "the machine went away"
      }
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$two"
      },
      "expect": {
        "code": 4002,
        "reason": "the machine went away"
      },
      "note": "the machine's close reached the last consumer, so the session is unbound"
    },
    {
      "on": "a",
      "op": "session.changes",
      "args": {
        "on": "$reg"
      },
      "expect": {
        "$contains": [
          {
            "kind": "bound",
            "session": "s"
          },
          {
            "kind": "attached",
            "session": "s",
            "origin": "one",
            "role": "participant"
          },
          {
            "kind": "attached",
            "session": "s",
            "origin": "two",
            "role": "participant"
          },
          {
            "kind": "control_changed",
            "session": "s",
            "origin": "one"
          },
          {
            "kind": "frame_appended",
            "session": "s",
            "origin": "one",
            "method": "echo",
            "sequence": 1
          },
          {
            "kind": "refused",
            "session": "s",
            "origin": "two",
            "method": "echo"
          },
          {
            "kind": "frame_appended",
            "session": "s",
            "method": "reverse",
            "sequence": 2
          },
          {
            "kind": "ask_raised",
            "session": "s",
            "method": "reverse"
          },
          {
            "kind": "ask_routed",
            "session": "s",
            "origin": "one",
            "method": "reverse"
          },
          {
            "kind": "control_changed",
            "session": "s",
            "origin": "two"
          },
          {
            "kind": "ask_routed",
            "session": "s",
            "origin": "two",
            "method": "reverse"
          },
          {
            "kind": "ask_answered",
            "session": "s",
            "origin": "two",
            "method": "reverse"
          },
          {
            "kind": "frame_appended",
            "session": "s",
            "origin": "two",
            "sequence": 3
          },
          {
            "kind": "detached",
            "session": "s",
            "origin": "one"
          },
          {
            "kind": "unbound",
            "session": "s"
          }
        ]
      }
    },
    {
      "on": "a",
      "op": "peer.observed",
      "args": {
        "on": "$near"
      },
      "expect": {
        "$contains": [
          {
            "type": "session.bound",
            "session": "s"
          },
          {
            "type": "session.attached",
            "session": "s",
            "origin": "one",
            "role": "participant",
            "after": 0
          },
          {
            "type": "session.attached",
            "session": "s",
            "origin": "two",
            "role": "participant",
            "after": 0
          },
          {
            "type": "control.changed",
            "session": "s",
            "origin": "one",
            "held": true
          },
          {
            "type": "frame.appended",
            "session": "s",
            "sequence": 1,
            "direction": "up",
            "origin": "one",
            "bytes": true,
            "method": "echo"
          },
          {
            "type": "session.refused",
            "session": "s",
            "code": "not_controlling",
            "method": "echo",
            "role": "participant",
            "origin": "two"
          },
          {
            "type": "frame.appended",
            "session": "s",
            "sequence": 2,
            "direction": "down",
            "bytes": true,
            "method": "reverse"
          },
          {
            "type": "ask.raised",
            "session": "s",
            "method": "reverse",
            "asking": true
          },
          {
            "type": "ask.routed",
            "session": "s",
            "method": "reverse",
            "origin": "one"
          },
          {
            "type": "control.changed",
            "session": "s",
            "origin": "two",
            "held": true
          },
          {
            "type": "ask.routed",
            "session": "s",
            "method": "reverse",
            "origin": "two"
          },
          {
            "type": "ask.answered",
            "session": "s",
            "method": "reverse",
            "origin": "two"
          },
          {
            "type": "frame.appended",
            "session": "s",
            "sequence": 3,
            "direction": "up",
            "origin": "two",
            "bytes": true
          },
          {
            "type": "session.detached",
            "session": "s",
            "role": "participant",
            "origin": "one"
          },
          {
            "type": "session.unbound",
            "session": "s",
            "code": 4002,
            "reason": "the machine went away"
          }
        ]
      },
      "note": "the session observes through the peer its machine's channel runs over"
    },
    {
      "on": "a",
      "op": "peer.observed",
      "args": {
        "on": "$pa"
      },
      "expect": {
        "$contains": []
      },
      "assert": {
        "absent": "session."
      },
      "note": "and through no consumer's"
    }
  ]
}
