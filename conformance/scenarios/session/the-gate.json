{
  "name": "the gate: a session bound on one side's registry with every consumer on the other, every frame held byte for byte",
  "layer": "session",
  "replaces": "session/go/interop_test.go with session/ts/src/interop.ts; run with each language as the relay by the pairing",
  "description": "A relay forwards a frame verbatim and mints the ids it sends on the same way in either language, so every frame here is held byte for byte on the other side of the boundary.",
  "needs": [
    "lazy",
    "peer",
    "pipe",
    "seam",
    "session",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "carrier_a"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "carrier_b"
    },
    {
      "on": "a",
      "op": "conn.pipe",
      "args": {
        "consume": "lazy"
      },
      "bind": {
        "a": "pipe_near",
        "b": "pipe_far"
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_near",
        "role": "client"
      },
      "bind": "near"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$pipe_far",
        "role": "server"
      },
      "bind": "far"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$near"
      },
      "bind": "tunnel_near"
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$far"
      },
      "bind": "tunnel_far"
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$tunnel_far",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "machine",
      "note": "the machine speaks over the far end of the channel"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$tunnel_near",
        "consume": "lazy"
      },
      "bind": "up",
      "note": "the registry binds the near end, which the session reads"
    },
    {
      "on": "a",
      "op": "session.new",
      "bind": "reg"
    },
    {
      "on": "a",
      "op": "session.bind",
      "args": {
        "on": "$reg",
        "session": "gate",
        "channel": "$up",
        "governance": {
          "decides": [
            "echo"
          ],
          "asks": [
            "reverse"
          ]
        }
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "one"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_one"
      },
      "expect": {
        "family": "probe"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "gate",
        "channel": "$ch_one",
        "role": "participant",
        "origin": "one",
        "after": 0
      },
      "bind": "att_one"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "two"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_two"
      },
      "expect": {
        "family": "probe"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "gate",
        "channel": "$ch_two",
        "role": "participant",
        "origin": "two",
        "after": 0
      },
      "bind": "att_two"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":null}}"
      }
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "gate",
        "attachment": "$att_one"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"one\"}}"
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"tracestate\":\"nightseam=gate\",\"data\":{\"text\":\"ready\",\"count\":0}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"tracestate\":\"nightseam=gate\",\"data\":{\"text\":\"ready\",\"count\":0}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"tracestate\":\"nightseam=gate\",\"data\":{\"text\":\"ready\",\"count\":0}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$one",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:7\",\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\",\"method\":\"echo\",\"params\":{\"text\":\"gate\",\"count\":1},\"tracestate\":\"nightseam=gate\",\"baggage\":{\"tenant\":\"acme\"}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\",\"method\":\"echo\",\"params\":{\"text\":\"gate\",\"count\":1},\"tracestate\":\"nightseam=gate\",\"baggage\":{\"tenant\":\"acme\"}}"
      },
      "note": "a consumer's request reaches the machine under an id of the session's own, with every member the relay knows nothing of where it was"
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"c:1\",\"result\":{\"text\":\"etag\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"c:7\",\"result\":{\"text\":\"etag\",\"count\":1}}"
      },
      "note": "and the answer reaches the one consumer that asked, under the id it asked with"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":3}}"
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b8-01\",\"method\":\"reverse\",\"params\":{\"text\":\"gate\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b8-01\",\"method\":\"reverse\",\"params\":{\"text\":\"gate\",\"count\":1}}"
      },
      "note": "what the machine asks reaches the holder"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":4}}"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$one",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"noticed\",\"data\":{\"text\":\"asked\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"noticed\",\"data\":{\"text\":\"asked\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "session.attention",
      "args": {
        "on": "$reg"
      },
      "expect": [
        "gate"
      ],
      "note": "the session with an open ask wants attention"
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "gate",
        "attachment": "$att_two"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"two\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"two\"}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b8-01\",\"method\":\"reverse\",\"params\":{\"text\":\"gate\",\"count\":1}}"
      },
      "note": "control moved while the ask was open, and the ask followed it as the machine sent it"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$one",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"stale\",\"count\":1}}"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$two",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"etag\",\"count\":1}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"response\",\"id\":\"s:1\",\"result\":{\"text\":\"etag\",\"count\":1}}"
      },
      "note": "only the consumer control moved to answers it: the other's answer is dropped"
    },
    {
      "on": "a",
      "op": "session.attention",
      "args": {
        "on": "$reg"
      },
      "expect": []
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$carrier_b",
        "family": "probe",
        "consume": "eager"
      },
      "bind": "late"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$carrier_a",
        "consume": "lazy"
      },
      "bind": {
        "handle": "ch_late"
      },
      "expect": {
        "family": "probe"
      }
    },
    {
      "on": "a",
      "op": "session.attach",
      "args": {
        "on": "$reg",
        "session": "gate",
        "channel": "$ch_late",
        "role": "observer",
        "origin": "late",
        "after": 1
      },
      "bind": "att_late"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.control\",\"data\":{\"holder\":\"two\"}}"
      },
      "note": "a consumer attaching is told the holder it joined before a frame of the replay"
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$machine",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"tracestate\":\"nightseam=late\",\"data\":{\"text\":\"live\",\"count\":2}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":6}}"
      },
      "note": "a replay hands a channel the machine's events alone: of the five frames after the one this consumer held, none is one — a request that went up and the answer that came down to the consumer that sent it, a request the machine asked of the holder and the answer that went up, an event of a consumer's — so the replay gives nothing and ends by saying where it reached"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"tracestate\":\"nightseam=late\",\"data\":{\"text\":\"live\",\"count\":2}}"
      },
      "note": "and then what is live"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$late"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":7}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"tracestate\":\"nightseam=late\",\"data\":{\"text\":\"live\",\"count\":2}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":7}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"changed\",\"tracestate\":\"nightseam=late\",\"data\":{\"text\":\"live\",\"count\":2}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"session.cursor\",\"data\":{\"sequence\":7}}"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$one",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "one read nothing of the exchange two was part of"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$two",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$one",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"noticed\",\"data\":{\"text\":\"replayed\",\"count\":6}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine"
      },
      "expect": {
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"noticed\",\"data\":{\"text\":\"replayed\",\"count\":6}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$machine",
        "within_ms": 250
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "the machine reads nothing else"
    },
    {
      "on": "a",
      "op": "conn.close",
      "args": {
        "on": "$machine",
        "code": 1008,
        "reason": "the machine went away"
      }
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$one"
      },
      "expect": {
        "code": 1008,
        "reason": "the machine went away"
      },
      "note": "the machine's channel closing ends every attached channel with its code and its reason"
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$two"
      },
      "expect": {
        "code": 1008,
        "reason": "the machine went away"
      }
    },
    {
      "on": "b",
      "op": "conn.await_close",
      "args": {
        "on": "$late"
      },
      "expect": {
        "code": 1008,
        "reason": "the machine went away"
      }
    },
    {
      "on": "a",
      "op": "session.await_change",
      "args": {
        "on": "$reg",
        "kind": "unbound"
      },
      "expect": {
        "kind": "unbound",
        "session": "gate"
      },
      "note": "and the session is gone from the registry"
    },
    {
      "on": "a",
      "op": "session.control",
      "args": {
        "on": "$reg",
        "session": "gate",
        "attachment": null
      },
      "expect_error": {
        "code": "$any"
      }
    }
  ]
}
