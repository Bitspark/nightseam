{
  "name": "@nightseam/live",
  "version": "0.5.0",
  "description": "Callable values across one connection: a scope over a peer, exported bindings, imported references, release and forwarding.",
  "license": "Apache-2.0",
  "author": "Bitspark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitspark/nightseam.git",
    "directory": "live/ts"
  },
  "homepage": "https://github.com/Bitspark/nightseam#readme",
  "bugs": "https://github.com/Bitspark/nightseam/issues",
  "keywords": [
    "duplex",
    "live",
    "callable",
    "references"
  ],
  "type": "module",
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@nightseam/runtime": "workspace:*"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --experimental-strip-types --test --test-timeout=10000 src/live.test.ts"
  },
  "devDependencies": {
    "@nightseam/duplex": "workspace:*",
    "typescript": "^7.0.2"
  }
}
