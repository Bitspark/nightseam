    "@nightseam/duplex": "0.6.0",
    "@nightseam/live": "0.6.0",
    "@nightseam/runtime": "0.6.0",
    "@probe/probe-client": "link:./api/ts/probe-client"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2"
  }
}
