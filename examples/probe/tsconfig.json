{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@probe/probe-client/types": ["./api/ts/probe-client/src/types.ts"]
    }
  },
  "include": ["client/src/**/*.ts", "api/ts/**/*.ts"]
}
