cabal-version: 2.4
name: nightseam-runtime
version: 0.5.0
synopsis: Native concurrent Nightseam duplex peer
license: Apache-2.0
license-file: LICENSE
extra-source-files: README.md, NOTICE
build-type: Simple

library
  exposed-modules: Nightseam.Runtime, Nightseam.Runtime.Identity, Nightseam.Runtime.Validate
  other-modules: Nightseam.Runtime.Validate.JSON, Nightseam.Runtime.Validate.Pattern
  hs-source-dirs: src
  build-depends: base >=4.18 && <5, nightseam-duplex ==0.5.0, aeson >=2, async, attoparsec, bytestring, containers, random, scientific, stm, text, time, vector
  default-language: Haskell2010
  ghc-options: -Wall

test-suite validator
  type: exitcode-stdio-1.0
  main-is: ValidateMain.hs
  hs-source-dirs: test
  build-depends: base, nightseam-runtime, aeson, bytestring, containers, text, vector, directory, filepath
  default-language: Haskell2010
  ghc-options: -threaded -Wall

test-suite peer
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base, nightseam-runtime, nightseam-duplex, aeson, bytestring, containers, text, stm, async
  default-language: Haskell2010
  ghc-options: -threaded -Wall

test-suite wire-peer
  type: exitcode-stdio-1.0
  main-is: WirePeerMain.hs
  hs-source-dirs: test
  build-depends: base, nightseam-runtime, nightseam-duplex, aeson, bytestring, containers, text, stm
  default-language: Haskell2010
  ghc-options: -threaded -Wall
