cabal-version: 2.4
name: nightseam-duplex
version: 0.5.0
synopsis: Ordered frames and relative-path Wire views
license: Apache-2.0
license-file: LICENSE
extra-source-files: README.md, NOTICE
build-type: Simple

library
  exposed-modules: Nightseam.Duplex, Nightseam.Duplex.WebSocket, Nightseam.Duplex.Wire
  hs-source-dirs: src
  build-depends: base >=4.18 && <5, aeson >=2, async, bytestring, containers, network, network-uri, stm, text, websockets
  default-language: Haskell2010
  ghc-options: -Wall

test-suite seam
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base, nightseam-duplex, bytestring, text, stm, async
  default-language: Haskell2010
  ghc-options: -threaded -Wall

test-suite wire
  type: exitcode-stdio-1.0
  main-is: WireMain.hs
  hs-source-dirs: test
  build-depends: base, nightseam-duplex, aeson, bytestring, containers, text, stm, async
  default-language: Haskell2010
  ghc-options: -threaded -Wall
